 IOReturn
-IOSurfaceRootUserClient::trapUseCount(__unused void *id, __unused void *category,
-    void *, void *, void *, void *)
-{
-	return kIOReturnSuccess;
+IOSurfaceRootUserClient::changeUseCount(void *id, void *category, bool add)
+{
+	if (!sweet_surface_use_enabled)
+		return kIOReturnSuccess;
+	uintptr_t cat = (uintptr_t)category;
+	if (cat >= 2)
+		return kIOReturnBadArgument;
+	IOLockLock(fLock);
+	SweetSurfaceRef *ref = findRef((uint32_t)(uintptr_t)id, NULL);
+	if (ref != NULL) {
+		uint8_t bit = (uint8_t)(1u << cat);
+		bool held = (ref->useMask & bit) != 0;
+		if (add != held) {
+			sweet_surface_use_change(ref->surface, (unsigned)cat, add);
+			ref->useMask = add ? ref->useMask | bit : ref->useMask & ~bit;
+		}
+	}
+	IOLockUnlock(fLock);
+	return ref != NULL ? kIOReturnSuccess : kIOReturnNotFound;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapIncrementUse(void *id, void *category, void *, void *, void *, void *)
+{
+	return changeUseCount(id, category, true);
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapDecrementUse(void *id, void *category, void *, void *, void *, void *)
+{
+	return changeUseCount(id, category, false);
 }
 
