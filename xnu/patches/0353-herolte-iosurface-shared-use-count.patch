 {
 	return (uint32_t *)((uint8_t *)s->state->getBytesNoCopy() + SWEET_SURFACE_STATE_SEED);
+}
+
+/* A framework client notifies the kernel only at local 0->1 / 1->0
+ * transitions. Track active clients per category in the shared state, not
+ * every local reference. The client map below owns each contribution. */
+static void
+sweet_surface_use_change(SweetSurface *s, unsigned category, bool add)
+{
+	volatile SInt32 *counts = (volatile SInt32 *)((uint8_t *)s->state->getBytesNoCopy() + SWEET_SURFACE_STATE_USE);
+	IOLockLock(sweet_surface_lock);
+	if (add)
+		OSIncrementAtomic(&counts[category]);
+	else if (counts[category] > 0)
+		OSDecrementAtomic(&counts[category]);
+	IOLockUnlock(sweet_surface_lock);
 }
 
