+
+/* AK7371: this phone's DT names product 12, 7-bit address 0x0c.
+ * AP access follows Samsung's on_i2c state: release ISP gpc2-4/5,
+ * use gpd2-2 SDA / gpd2-3 SCL. GPIO outputs only ever pull low.
+ * Existing rear power-up supplies the stock 2.8 V AF rail. */
+static bool rc_af_ready, rc_af_saved;
+static uint8_t rc_af_old_control;
+static uint16_t rc_af_position, rc_af_old_position;
+
+static bool
+rc_af_line(unsigned pin, bool release)
+{
+	rc_pin(B_GPD2, pin, release ? 0 : 1, -1, release ? -1 : 0);
+	delay(5);
+	if (pin == 3 && release) {
+		for (unsigned n = 0; n < 1000; n++) {
+			if (rc_rd(rc_pins, B_GPD2 + 4) & (1u << 3))
+				return true;
+			delay(1);
+		}
+		return false;
+	}
+	return true;
+}
+
+static bool
+rc_af_start(void)
+{
+	return rc_af_line(2, true) && rc_af_line(3, true) && rc_af_line(2, false) && rc_af_line(3, false);
+}
+
+static void
+rc_af_stop(void)
+{
+	(void)rc_af_line(2, false);
+	(void)rc_af_line(3, true);
+	(void)rc_af_line(2, true);
+}
+
+static bool
+rc_af_out(uint8_t byte)
+{
+	for (int bit = 7; bit >= 0; bit--)
+		if (!rc_af_line(2, (byte >> bit) & 1) || !rc_af_line(3, true) || !rc_af_line(3, false))
+			return false;
+	if (!rc_af_line(2, true) || !rc_af_line(3, true))
+		return false;
+	bool ack = !(rc_rd(rc_pins, B_GPD2 + 4) & (1u << 2));
+	(void)rc_af_line(3, false);
+	return ack;
+}
+
+static int
+rc_af_read(uint8_t reg)
+{
+	uint8_t value = 0;
+	bool ok = rc_af_start() && rc_af_out(0x18) && rc_af_out(reg) && rc_af_start() && rc_af_out(0x19);
+	for (unsigned bit = 0; ok && bit < 8; bit++) {
+		ok = rc_af_line(3, true);
+		value = (uint8_t)((value << 1) | ((rc_rd(rc_pins, B_GPD2 + 4) >> 2) & 1));
+		(void)rc_af_line(3, false);
+	}
+	/* Single-byte receive ends with NACK. */
+	if (ok)
+		ok = rc_af_line(2, true) && rc_af_line(3, true) && rc_af_line(3, false);
+	rc_af_stop();
+	return ok ? value : -1;
+}
+
+static bool
+rc_af_write(uint8_t reg, uint8_t value)
+{
+	bool ok = rc_af_start() && rc_af_out(0x18) && rc_af_out(reg) && rc_af_out(value);
+	rc_af_stop();
+	return ok;
+}
+
+static bool
+rc_af_set_position(uint16_t position)
+{
+	if (position > 511 || !rc_af_write(0, (uint8_t)(position >> 1)) ||
+	    !rc_af_write(1, (uint8_t)((position & 1) << 7)))
+		return false;
+	int high = rc_af_read(0), low = rc_af_read(1);
+	if (high < 0 || low < 0 || ((high << 1) | (low >> 7)) != position)
+		return false;
+	rc_af_position = position;
+	return true;
+}
+
+static void
+rc_af_initialize(void)
+{
+	rc_af_ready = rc_af_saved = false;
+	rc_pin(B_GPC2, 4, 0, 0, -1);
+	rc_pin(B_GPC2, 5, 0, 0, -1);
+	rc_pin(B_GPD2, 2, 0, 0, -1);
+	rc_pin(B_GPD2, 3, 0, 0, -1);
+	if ((rc_rd(rc_pins, B_GPD2 + 4) & 12) != 12) {
+		printf("rcam: AF: AP bus is not idle; no motor writes\n");
+		return;
+	}
+	int id = rc_af_read(3);
+	if (id != 9) {
+		printf("rcam: AF: AK7371 ID %d (expected 9); no motor writes\n", id);
+		return;
+	}
+	int control = rc_af_read(2), high = rc_af_read(0), low = rc_af_read(1);
+	if (control < 0 || high < 0 || low < 0)
+		return;
+	rc_af_old_control = (uint8_t)control;
+	rc_af_old_position = rc_af_position = (uint16_t)((high << 1) | (low >> 7));
+	rc_af_saved = true;
+	/* Samsung's default initial position, programmed before active mode. */
+	rc_af_ready = rc_af_set_position(120) && rc_af_write(2, 0) && rc_af_read(2) == 0;
+	delay(2000);
+	printf("rcam: AF: AK7371 ID 9, initial 120/511, readback %s\n", rc_af_ready ? "OK" : "FAILED");
+}
+
+static void
+rc_af_restore(void)
+{
+	if (rc_af_saved) {
+		/* Restore the previously found target in small steps, before its
+		 * original mode and power rails; never throw the lens end to end. */
+		for (unsigned i = 0; i < 22 && rc_af_position != rc_af_old_position; i++) {
+			uint16_t next = rc_af_position < rc_af_old_position ?
+			    MIN(rc_af_position + 24, rc_af_old_position) : MAX((int)rc_af_position - 24, rc_af_old_position);
+			if (!rc_af_set_position(next))
+				break;
+			delay(2000);
+		}
+		(void)rc_af_write(2, rc_af_old_control);
+	}
+	rc_af_ready = rc_af_saved = false;
 }
 
