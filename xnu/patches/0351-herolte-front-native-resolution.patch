diff --git a/bsd/dev/herolte_gl.c b/bsd/dev/herolte_gl.c
--- a/bsd/dev/herolte_gl.c
+++ b/bsd/dev/herolte_gl.c
@@ -2384,7 +2384,7 @@
 #define NC_BUF          0xd0800000u
 #define NC_FULL_W       2608u
 #define NC_FULL_H       1960u
-#define NC_MAP_LEN      0xa00000u       /* 0457: the mapping covers a full frame and the stream's ring of 4 x 0x280000 */
+#define NC_MAP_LEN      0x2800000u      /* native front: four 10 MiB DMA slots, below rear at 0xd4000000 */
 /* 0455: the frame's size by mode (0 full 2608x1960, 1 2x2 binned 1304x980, 2 centred 1280x720 crop), and the options
  * that were boot-args (the line is nearly full): sysctl kern.notefe_cam_{tp,skip,pll,settle,mode} (root), set by the bot
  * from the drop zone's cam.opts; a boot-arg of the same name (notefe_cam_tp ...) still wins. */
@@ -2773,9 +2773,9 @@
 #include <miscfs/devfs/devfs.h>
 #include <sys/conf.h>
 #include <sys/uio.h>
-#define NC_SLOT         0x280000u
-#define NC_SW           1304u
-#define NC_SH           980u
+#define NC_SLOT         0xa00000u
+#define NC_SW           2608u
+#define NC_SH           1960u
 #define NC_STRIDE       (NC_SW * 5 / 4)
 #include "herolte_camera.h"
 static LCK_GRP_DECLARE(nc_dev_grp, "herolte_camera_device");
@@ -2898,8 +2898,8 @@
 		uint16_t v = nc_4e6_mode[i].reg == 0x0306 ? (uint16_t)nc_o_pll : nc_4e6_mode[i].val;
 		bad += !nc_sensor_write(0x35, nc_4e6_mode[i].reg, v, nc_4e6_mode[i].bits);
 	}
-	bad += !nc_sensor_write(0x35, 0x0900, 0x01, 8);
-	bad += !nc_sensor_write(0x35, 0x0901, 0x22, 8);
+	/* The phone's validated 4E6 table already selects 2608x1960.
+	 * Do not replace its native mode with generic SMIA binning writes. */
 	bad += !nc_sensor_write(0x35, 0x034c, NC_SW, 16);
 	bad += !nc_sensor_write(0x35, 0x034e, NC_SH, 16);
 	if (nc_o_tp) {
@@ -2930,7 +2930,7 @@
 	nc_reads = 0;
 	nc_torn = 0;
 	nc_sensor_write(0x35, 0x0100, 1, 8);
-	printf("NOTEFE CAM: stream: up, %u x %u binned, test pattern %u, %u writes not acknowledged\n", NC_SW, NC_SH, nc_o_tp, bad);
+	printf("NOTEFE CAM: stream: up, %u x %u native, test pattern %u, %u writes not acknowledged\n", NC_SW, NC_SH, nc_o_tp, bad);
 	return 0;
 }
 
@@ -3032,8 +3032,10 @@
 		nc_frame_c = notefe_physmap_cached(NC_BUF, NC_MAP_LEN);
 	}
 	if (nc_frame_c) {
-		src0 = nc_frame_c + slot * NC_SLOT;
-		flush_dcache(src0, NC_SW * NC_SH * 2, 0);
+		vm_offset_t cached = nc_frame_c + slot * NC_SLOT;
+		flush_dcache(cached, NC_SW * NC_SH * 2, 0);
+		bcopy((const void *)cached, nc_copy, NC_SW * NC_SH * 2);
+		src0 = (vm_offset_t)nc_copy;
 	} else {
 		bcopy((const void *)(nc_frame + slot * NC_SLOT), nc_copy, NC_SW * NC_SH * 2);
 		src0 = (vm_offset_t)nc_copy;
@@ -3041,6 +3043,7 @@
 	uint32_t after = notefe_rd(csis, 0x100);
 	if (after - f >= 3) {
 		nc_torn++;
+		return EAGAIN; /* discard a reused DMA slot before any uiomove */
 	}
 	struct nc_cam_frame h = { .magic = "RWFRAME", .header_bytes = sizeof(h), .width = NC_SW, .height = NC_SH,
 		                  .stride = NC_STRIDE, .format = 1, .bayer = 1, .black = 64, .sequence = nc_seq,
diff --git a/bsd/dev/herolte_rcam.c b/bsd/dev/herolte_rcam.c
--- a/bsd/dev/herolte_rcam.c
+++ b/bsd/dev/herolte_rcam.c
@@ -53,7 +53,7 @@
 #define RC_CAM0L        0x140f0000u     /* CMU_CAM0_LOCAL */
 #define RC_PHY0         0x144f1000u     /* phy_cam0_csi@144F1040: reset bit 1 for phy 0 (CSIS0) */
 #define RC_MMU          0x140e0000u     /* the SysMMU whose master list has fimc_is_sensor@14000000 */
-#define RC_BUF          0xd1400000u     /* camera ION carve-out 0xd0800000 + 0xe400000; the front uses its first 10 MB */
+#define RC_BUF          0xd4000000u     /* inside camera ION; native front uses 0xd0800000..0xd3000000 */
 #define RC_SLOT         0x1200000u      /* 18 MB: a mode-3 frame (4032 x 2268 x 2) fits; mode 7 is 6096384 bytes */
 #define RC_MAP_LEN      (2 * RC_SLOT)   /* slot 0: the first frame (DMA0 ADDR1), slot 1: the later ones (ADDR2-8) */
 
