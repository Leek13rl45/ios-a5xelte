+/* mode 3, 4032x2268 60 fps: this phone's ISP firmware table (the public setA 4032x2268_60fps differs); not used by
+ * default (kern.herolte_rcam_mode=3) (57 writes) */
+static const struct rc_reg8 rc_imx260_mode3[] = {
+	{ 0x9007, 0x00 }, { 0x30f2, 0x00 }, { 0x0112, 0x0a }, { 0x0113, 0x0a }, { 0x0114, 0x03 }, { 0x0220, 0x61 },
+	{ 0x0221, 0x11 }, { 0x0340, 0x09 }, { 0x0341, 0x8c }, { 0x0342, 0x16 }, { 0x0343, 0x44 }, { 0x0381, 0x01 },
+	{ 0x0383, 0x01 }, { 0x0385, 0x01 }, { 0x0387, 0x01 }, { 0x0900, 0x00 }, { 0x0901, 0x11 }, { 0x30f4, 0x02 },
+	{ 0x30f5, 0xbc }, { 0x30f6, 0x02 }, { 0x30f7, 0x8a }, { 0x31a0, 0x02 }, { 0x31a3, 0x01 }, { 0x31a5, 0x00 },
+	{ 0x31a6, 0x00 }, { 0x560f, 0xe6 }, { 0x0344, 0x00 }, { 0x0345, 0x00 }, { 0x0346, 0x01 }, { 0x0347, 0x78 },
+	{ 0x0348, 0x0f }, { 0x0349, 0xbf }, { 0x034a, 0x0a }, { 0x034b, 0x57 }, { 0x034c, 0x0f }, { 0x034d, 0xc0 },
+	{ 0x034e, 0x08 }, { 0x034f, 0xdc }, { 0x0408, 0x00 }, { 0x0409, 0x00 }, { 0x040a, 0x00 }, { 0x040b, 0x00 },
+	{ 0x040c, 0x0f }, { 0x040d, 0xc0 }, { 0x040e, 0x08 }, { 0x040f, 0xe0 }, { 0x0301, 0x03 }, { 0x0303, 0x02 },
+	{ 0x0305, 0x04 }, { 0x0306, 0x00 }, { 0x0307, 0xc1 }, { 0x0309, 0x0a }, { 0x030b, 0x01 }, { 0x030d, 0x04 },
+	{ 0x030e, 0x01 }, { 0x030f, 0x3c }, { 0x0310, 0x01 },
+};
+
+#define RC_N(t) ((unsigned)(sizeof(t) / sizeof((t)[0])))
+
+/* mode -> frame size and Samsung's CSIS values (fimc-is-module-imx260.c config_imx260[]: settle, mipi_speed) */
+static uint32_t rc_w = 2016, rc_h = 1512, rc_mode_settle = 30;
+static bool rc_mode_deskew;
+
+static unsigned
+rc_write_table(const struct rc_reg8 *t, unsigned n)
+{
+	unsigned bad = 0;
+	for (unsigned i = 0; i < n; i++) {
+		bad += !rc_sensor_wr8(t[i].reg, t[i].val);
+	}
+	return bad;
+}
+
+static bool
+rc_sensor_init(void)
+{
+	if (!rc_booted) {
+		printf("rcam: stage 4: the companion has no firmware yet (stage 3): stopped\n");
+		return false;
+	}
+	if (rc_streaming) {
+		rc_stream_down();
+	}
+	unsigned mode = rc_o_mode == 3 ? 3 : 7;
+	if (rc_o_mode != mode) {
+		printf("rcam: stage 4: mode %u is not embedded; mode 7\n", rc_o_mode);
+	}
+	rc_w = mode == 3 ? 4032 : 2016;
+	rc_h = mode == 3 ? 2268 : 1512;
+	rc_mode_settle = mode == 3 ? 45 : 30;           /* FIMC_IS_SENSOR_CFG_EXT(4032, 2268, 60, 45, 3, 4 lanes, 2145) */
+	rc_mode_deskew = mode == 3;                     /* FIMC_IS_SENSOR_CFG(2016, 1512, 30, 30, 7, 4 lanes): mipi_speed 0 */
+	int id = rc_sensor_rd16(0x0016);
+	printf("rcam: stage 4: IMX260 0x0016/7 %#x; standby (0x0100 = 0): %s\n", (unsigned)id, rc_sensor_wr8(0x0100, 0x00) ? "ok" : "NACK");
+	unsigned bg = rc_write_table(rc_imx260_global, RC_N(rc_imx260_global));
+	unsigned be = rc_write_table(rc_imx260_extra, RC_N(rc_imx260_extra));
+	unsigned bm = mode == 3 ? rc_write_table(rc_imx260_mode3, RC_N(rc_imx260_mode3)) :
+	    rc_write_table(rc_imx260_mode7, RC_N(rc_imx260_mode7));
+	printf("rcam: stage 4: global %u writes (%u NACK), extra %u (%u NACK), mode %u %u writes (%u NACK)\n",
+	    RC_N(rc_imx260_global), bg, RC_N(rc_imx260_extra), be, mode, mode == 3 ? RC_N(rc_imx260_mode3) : RC_N(rc_imx260_mode7),
+	    bm);
+	printf("rcam: stage 4: read back: EXCK %#x, format %#x, lanes-1 %d, output %d x %d, FLL %d, LLP %d, binning %d/%#x, "
+	    "PLL ivt %d/%d iop %d/%d\n", (unsigned)rc_sensor_rd16(0x0136), (unsigned)rc_sensor_rd16(0x0112), rc_sensor_rd8(0x0114),
+	    rc_sensor_rd16(0x034c), rc_sensor_rd16(0x034e), rc_sensor_rd16(0x0340), rc_sensor_rd16(0x0342),
+	    rc_sensor_rd8(0x0900), (unsigned)rc_sensor_rd8(0x0901), rc_sensor_rd8(0x0305), rc_sensor_rd16(0x0306), rc_sensor_rd8(0x030d),
+	    rc_sensor_rd16(0x030e));
+	/* the companion's bypass (from the ISP firmware, an inference): 0x003a = 0x0099 on, 0 off */
+	int before = rc_comp_i2c_rd(0x003a);
+	bool w = rc_comp_i2c_wr(0x003a, (uint16_t)rc_o_bypass);
+	if (!w) {
+		rc_spi_wr16(0x003a, (uint16_t)rc_o_bypass);
+	}
+	int after = rc_comp_i2c_rd(0x003a);
+	printf("rcam: stage 4: companion 0x003a: was %#x, wrote %#x over %s, reads %#x: %s\n", (unsigned)before, rc_o_bypass,
+	    w ? "I2C" : "SPI (I2C NACK)", (unsigned)after, after == (int)(uint16_t)rc_o_bypass ? "bypass set" : "NOT as written");
+	if (bg || be || bm) {
+		printf("rcam: stage 4: some sensor writes were not acknowledged: stopped\n");
+		return false;
+	}
+	rc_configured = true;
+	return true;
+}
+
+/* ---- stage 5: CSIS0 + D-PHY + SysMMU, stream, one frame ---- */
+static const struct { bool local; uint16_t off; uint32_t mask; const char *name; } rc_gates[] = {
+	{ false, 0x800, 1u << 0, "ACLK_CSIS0" }, { true, 0x800, 1u << 0, "ACLK_CSIS0 (local)" },
+	{ false, 0x83c, 1u << 0, "PCLK_CSIS0" }, { true, 0x83c, 1u << 0, "PCLK_CSIS0 (local)" },
+	{ false, 0x848, 1u << 0, "HS0_CSIS0_RX_BYTE" }, { false, 0x84c, 1u << 0, "HS1_CSIS0_RX_BYTE" },
+	{ false, 0x850, 1u << 0, "HS2_CSIS0_RX_BYTE" }, { false, 0x854, 1u << 0, "HS3_CSIS0_RX_BYTE" },
+	{ false, 0x838, 0xfu, "TREX_528 (LH_ASYNC_SI_CAM0, TREX_A, SysMMU6, SFW110)" },
+	{ false, 0x840, 0x3u, "PCLK TREX_132 (SFW110, SysMMU6)" },
+};
+#define RC_NGATES (sizeof(rc_gates) / sizeof(rc_gates[0]))
+static struct {
+	uint32_t gate[RC_NGATES], rx_mux[4], csis_user, mmu_ctrl, iso, phyc;
+	bool saved;
+} rc_rx;
+
+static void
+rc_csis_report(const char *when)
+{
+	uint32_t s0 = rc_rd(rc_csis, 0x14), s1 = rc_rd(rc_csis, 0x1c);
+	int fc = rc_sensor_rd8(0x0005);
+	printf("rcam: frame %s: CSIS0 INT_SRC0 %#x: ch0 start %u end %u; errors SOT_HS %u lost FS %u lost FE %u overflow %u "
+	    "wrong cfg %u ECC %u CRC %u ID %u; INT_SRC1 %#x: DMA start %u end %u error %u\n", when, s0, (s0 >> 24) & 1,
+	    (s0 >> 20) & 1, (s0 >> 16) & 1, (s0 >> 12) & 1, (s0 >> 8) & 1, (s0 >> 4) & 1, (s0 >> 3) & 1, (s0 >> 2) & 1,
+	    (s0 >> 1) & 1, s0 & 1, s1, (s1 >> 4) & 1, (s1 >> 8) & 1, (s1 >> 12) & 1);
+	printf("rcam: frame %s: FRM_CNT_CH0 %u, DPHY_STATUS %#x, DMA0 ctrl %#x act_ctrl %#x byte count %u, DMA err %#x; "
+	    "sensor frame count %d; SysMMU status %#x\n", when, rc_rd(rc_csis, 0x100), rc_rd(rc_csis, 0x20),
+	    rc_rd(rc_csis, 0x1000), rc_rd(rc_csis, 0x1030), rc_rd(rc_csis, 0x1040), rc_rd(rc_csis, 0x1404), fc,
+	    rc_rd(rc_mmu, 8));
+}
+
+/* Samsung's csi_stream_on order (fimc-is-device-csi_v2.c, fimc-is-hw-csi-v4_0.c), 0342's nc_csis_setup for 4 lanes */
+static void
+rc_csis_setup(uint32_t settle, bool deskew)
+{
+	vm_offset_t c = rc_csis;
+	rc_wr(c, 0x4, rc_rd(c, 0x4) & ~1u);                             /* CSI_EN off */
+	rc_wr(c, 0x24, rc_rd(c, 0x24) & ~1u);                           /* ENABLE_CLK off */
+	rc_wr(c, 0x4, rc_rd(c, 0x4) | 2u);                              /* SW_RESET */
+	for (unsigned n = 0; n < 100 && (rc_rd(c, 0x4) & 2u); n++) {
+		delay(10);
+	}
+	for (unsigned vc = 0; vc < 4; vc++) {                           /* every VC's DMA off */
+		rc_wr(c, 0x1000 + vc * 0x100, (rc_rd(c, 0x1000 + vc * 0x100) | 1u) & ~2u);
+	}
+	/* DPHY_CMN_CTRL: HSSETTLE 31:24, ENABLE_DAT 4:1 = 0xf (4 lanes) */
+	rc_wr(c, 0x24, (rc_rd(c, 0x24) & ~(0xffu << 24) & ~(0xfu << 1) & ~(1u << 21)) | ((settle & 0xff) << 24) | (0xfu << 1));
+	/* CSIS_CMN_CTRL: LANE_NUMBER 9:8 = 3, INTERLEAVE 11:10 = 0 (CH0 only), DESKEW_ENABLE 12 */
+	rc_wr(c, 0x4, (rc_rd(c, 0x4) & ~(3u << 8) & ~(1u << 12) & ~(3u << 10)) | (3u << 8) | (deskew ? (1u << 12) : 0));
+	if (deskew) {
+		/* csi_hw_s_lane for > 1.5 Gbps: S_DPHYCTL_H [33] skew calibration, [39:34] 0x24, [63:60] 3; S_BYTE_CLK_ENABLE */
+		rc_wr(c, 0x3c, (rc_rd(c, 0x3c) & ~0xf00000feu) | (1u << 1) | (0x24u << 2) | (0x3u << 28));
+		rc_wr(c, 0x24, rc_rd(c, 0x24) | (1u << 21));
+	}
+	/* ISP_CONFIG_CH0: VC 0, DATAFORMAT 0x2b (RAW10) at 7:2, DOUBLE_CMPNT 12; ISP_RESOL_CH0 */
+	rc_wr(c, 0x40, (rc_rd(c, 0x40) & ~0x1fffu) | (0x2bu << 2) | (1u << 12));
+	rc_wr(c, 0x44, (rc_h << 16) | rc_w);
+	/* DMA0_FMT: 2D, normal packing (16 bits a pixel), as the front; ADDR1 = slot 0 (the first frame), ADDR2-8 = slot 1 */
+	rc_wr(c, 0x1004, rc_rd(c, 0x1004) & ~(3u << 14));
+	rc_wr(c, 0x1010, RC_BUF);
+	for (uint32_t a = 0x1014; a <= 0x102c; a += 4) {
+		rc_wr(c, a, RC_BUF + RC_SLOT);
+	}
+	rc_wr(c, 0x1000, (rc_rd(c, 0x1000) & ~1u) | 2u);               /* DMA0 on, pointer update */
+	rc_wr(c, 0x14, rc_rd(c, 0x14));                                 /* clear what is pending */
+	rc_wr(c, 0x1c, rc_rd(c, 0x1c));
+	rc_wr(c, 0x4, rc_rd(c, 0x4) | (0xfu << 16));                    /* UPDATE_SHADOW */
+	rc_wr(c, 0x24, rc_rd(c, 0x24) | 1u);                            /* D-PHY clock lane on */
+	rc_wr(c, 0x4, rc_rd(c, 0x4) | 1u);                              /* CSI_EN */
+}
+
+/* the receiver down and every register of it as found */
+static void
+rc_rx_down(void)
+{
+	if (!rc_rx.saved) {
+		return;
+	}
+	vm_offset_t c = rc_csis;
+	rc_wr(c, 0x1000, rc_rd(c, 0x1000) | 1u);
+	rc_wr(c, 0x4, rc_rd(c, 0x4) & ~1u);
+	rc_wr(c, 0x24, rc_rd(c, 0x24) & ~0x1fu);
+	rc_wr(c, 0x4, rc_rd(c, 0x4) | 2u);
+	delay(100);
+	for (unsigned n = 0; n < 4; n++) {
+		rc_wr(rc_cam0, 0x220 + 4 * n, rc_rx.rx_mux[n]);
+	}
+	rc_wr(rc_phy, 0x40, rc_rx.phyc & ~2u);
+	rc_wr(rc_phy, 0x40, rc_rx.phyc);
+	if (!(rc_rx.iso & 1u)) {                        /* 0x70c is the DSI's too: only cleared if rcam set it */
+		rc_wr(rc_pmu, 0x70c, rc_rd(rc_pmu, 0x70c) & ~1u);
+	}
+	rc_wr(rc_mmu, 0, rc_rx.mmu_ctrl);
+	for (unsigned i = 0; i < RC_NGATES; i++) {
+		vm_offset_t b = rc_gates[i].local ? rc_cam0l : rc_cam0;
+		rc_wr(b, rc_gates[i].off, (rc_rd(b, rc_gates[i].off) & ~rc_gates[i].mask) | (rc_rx.gate[i] & rc_gates[i].mask));
+	}
+	rc_wr(rc_cam0, 0x200, rc_rx.csis_user);
+	rc_rx.saved = false;
+	printf("rcam: receiver as found (SysMMU ctrl %#x, PHY %#x, PMU 0x70c %#x)\n", rc_rd(rc_mmu, 0), rc_rd(rc_phy, 0x40),
+	    rc_rd(rc_pmu, 0x70c));
+}
+
+static void
+rc_stream_down(void)
+{
+	rc_sensor_wr8(0x0100, 0x00);
+	delay(50000);
+	rc_rx_down();
+	rc_streaming = false;
+	printf("rcam: stream off\n");
+}
+
+/* the captured frame (slot 0) for userland: kern.herolte_rcam_pic_info / _pic / _pic_off */
+static struct {
+	bool valid;
+	uint32_t w, h, frame_bytes, bytes, changed, mn, mx, mean, untouched, dma_bytes, frames, mode;
+} rc_pic;
+
+static void
+rc_frame_stats(const char *what, vm_offset_t slot, uint32_t fbytes, bool keep)
+{
+	volatile uint16_t *px = (volatile uint16_t *)slot;
+	uint32_t mn = 0xffff, mx = 0, untouched = 0;
+	uint64_t sum = 0;
+	for (unsigned i = 0; i < 2048; i++) {           /* the first 4 KiB */
+		uint16_t v = px[i];
+		if (v == 0xa5a5) {
+			untouched++;
+		}
+		v &= 0x3ff;
+		mn = MIN(mn, v);
+		mx = MAX(mx, v);
+		sum += v;
+	}
+	uint32_t changed = 0, last = 0;
+	for (uint32_t o = 0; o < fbytes; o += 4) {
+		if (*(volatile uint32_t *)(slot + o) != 0xa5a5a5a5u) {
+			changed++;
+			last = o;
+		}
+	}
+	volatile uint32_t *w = (volatile uint32_t *)slot;
+	printf("rcam: %s: %u of %u bytes written (the last at +%#x, a frame ends at +%#x); first 4 KiB (2048 pixels & 0x3ff): "
+	    "min %u max %u mean %llu, %u still 0xa5a5; first words %08x %08x %08x %08x\n", what, changed * 4, fbytes, last,
+	    fbytes - 4, mn, mx, sum / 2048, untouched, w[0], w[1], w[2], w[3]);
+	if (keep) {
+		rc_pic.w = rc_w;
+		rc_pic.h = rc_h;
+		rc_pic.frame_bytes = fbytes;
+		rc_pic.bytes = changed ? last + 4 : 0;  /* up to the last word the DMA changed */
+		rc_pic.changed = changed * 4;
+		rc_pic.mn = mn;
+		rc_pic.mx = mx;
+		rc_pic.mean = (uint32_t)(sum / 2048);
+		rc_pic.untouched = untouched;
+		rc_pic.valid = changed != 0;
+	}
+}
+
+static uint32_t rc_pic_off;
+SYSCTL_UINT(_kern, OID_AUTO, herolte_rcam_pic_off, CTLFLAG_RW | CTLFLAG_LOCKED, &rc_pic_off, 0,
+    "rear camera: the offset in the frame that kern.herolte_rcam_pic reads from");
+
+static int
+rc_pic_info_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char text[512];
+	lck_mtx_lock(&rc_mtx);
+	if (!rc_pic.valid) {
+		lck_mtx_unlock(&rc_mtx);
+		return ENOENT;
+	}
+	int n = snprintf(text, sizeof(text), "width %u\nheight %u\nbytes_per_pixel 2\nformat RAW10 in bits 9:0, little-endian, "
+	    "Bayer order unknown\nmode %u\nbytes %u\nframe_bytes %u\nchanged_bytes %u\ndma_byte_count %u\nframes_counted %u\n"
+	    "first4k_min %u\nfirst4k_max %u\nfirst4k_mean %u\nfirst4k_untouched %u\nphys %#x\n", rc_pic.w, rc_pic.h, rc_pic.mode,
+	    rc_pic.bytes, rc_pic.frame_bytes, rc_pic.changed, rc_pic.dma_bytes, rc_pic.frames, rc_pic.mn, rc_pic.mx, rc_pic.mean,
+	    rc_pic.untouched, RC_BUF);
+	lck_mtx_unlock(&rc_mtx);
+	return SYSCTL_OUT(req, text, (size_t)MIN(n, (int)sizeof(text) - 1) + 1);
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, herolte_rcam_pic_info, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    NULL, 0, rc_pic_info_sysctl, "A", "rear camera: the captured frame's size and stats (text)");
+
+/* as 0342's notefe_cam_pic (root, opaque), but in chunks: up to 1 MiB of slot 0 from kern.herolte_rcam_pic_off */
+static int
+rc_pic_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	if (!kauth_cred_issuser(kauth_cred_get())) {
+		return EPERM;
+	}
+	lck_mtx_lock(&rc_mtx);
+	if (!rc_pic.valid || !rc_ring) {
+		lck_mtx_unlock(&rc_mtx);
+		return ENOENT;
+	}
+	uint32_t off = rc_pic_off, n = off < rc_pic.bytes ? MIN(rc_pic.bytes - off, 1024u * 1024u) : 0;
+	int error = SYSCTL_OUT(req, (const void *)(rc_ring + off), n);
+	lck_mtx_unlock(&rc_mtx);
+	return error;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, herolte_rcam_pic, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    NULL, 0, rc_pic_sysctl, "S", "rear camera: the captured frame (slot 0, 16 bits a pixel), up to 1 MiB from _pic_off");
+
+static bool
+rc_capture(void)
+{
+	if (!rc_configured) {
+		printf("rcam: stage 5: the sensor is not set up (stage 4): stopped\n");
+		return false;
+	}
+	if (rc_streaming) {
+		printf("rcam: stage 5: still streaming from before: stream off first\n");
+		rc_stream_down();
+	}
+	/* the camera domains: no CMU_CAM0 / CSIS0 register is touched while they are off */
+	uint32_t c0 = rc_rd(rc_pmu, 0x4024), c1 = rc_rd(rc_pmu, 0x40a4);
+	printf("rcam: stage 5: domains cam0 config %#x status %#x, cam1 config %#x status %#x\n", rc_rd(rc_pmu, 0x4020), c0,
+	    rc_rd(rc_pmu, 0x40a0), c1);
+	if ((c0 & 0xf) != 0xf || (c1 & 0xf) != 0xf) {
+		printf("rcam: stage 5: a camera power domain is off: stopped (rcam does not switch domains)\n");
+		return false;
+	}
+	if (!rc_csis) {
+		rc_csis = ml_io_map(RC_CSIS0, 0x2000);
+		rc_cam0 = ml_io_map(RC_CAM0, 0x1000);
+		rc_cam0l = ml_io_map(RC_CAM0L, 0x1000);
+		rc_phy = ml_io_map(RC_PHY0, 0x1000);
+		rc_mmu = ml_io_map(RC_MMU, 0x1000);
+	}
+	if (!rc_ring) {
+		rc_ring = notefe_physmap(RC_BUF, RC_MAP_LEN);
+	}
+	if (!rc_csis || !rc_cam0 || !rc_cam0l || !rc_phy || !rc_mmu || !rc_ring) {
+		printf("rcam: stage 5: map failed\n");
+		return false;
+	}
+	/* clocks: CSIS0's user mux must come from CMU_TOP's ACLK_CAM0_CSIS0_414 (mux 0x2b8 bit 21, div 0x418, gate 0x878) */
+	uint32_t tmux = rc_rd(rc_top, 0x2b8), tdiv = rc_rd(rc_top, 0x418), tgate = rc_rd(rc_top, 0x878);
+	uint32_t user = rc_rd(rc_cam0, 0x200);
+	printf("rcam: stage 5: TOP ACLK_CAM0_CSIS0_414 mux %#x div %#x gate %#x; CAM0 user mux %#x (status %#x), TREX_528 user "
+	    "%#x\n", tmux, tdiv, tgate, user, rc_rd(rc_cam0, 0x600), rc_rd(rc_cam0, 0x21c));
+	if (!((user >> 12) & 1) && (!(tgate & 1) || !((tmux >> 21) & 1))) {
+		printf("rcam: stage 5: CSIS0's clock is OSCCLK and the TOP clock is gated: stopped (CMU_TOP not written)\n");
+		return false;
+	}
+	rc_rx.csis_user = user;
+	for (unsigned i = 0; i < RC_NGATES; i++) {
+		vm_offset_t b = rc_gates[i].local ? rc_cam0l : rc_cam0;
+		rc_rx.gate[i] = rc_rd(b, rc_gates[i].off);
+		if ((rc_rx.gate[i] & rc_gates[i].mask) != rc_gates[i].mask) {
+			rc_wr(b, rc_gates[i].off, rc_rx.gate[i] | rc_gates[i].mask);
+		}
+		printf("rcam: stage 5: gate %s %#x -> %#x\n", rc_gates[i].name, rc_rx.gate[i], rc_rd(b, rc_gates[i].off));
+	}
+	if (!((user >> 12) & 1)) {
+		rc_wr(rc_cam0, 0x200, user | (1u << 12));
+		for (unsigned n = 0; n < 1000 && ((rc_rd(rc_cam0, 0x600) >> 12) & 7) != 2; n++) {
+			delay(1);
+		}
+		printf("rcam: stage 5: CSIS0 user mux to the TOP clock: %#x (status %#x)\n", rc_rd(rc_cam0, 0x200), rc_rd(rc_cam0, 0x600));
+	}
+	rc_rx.saved = true;                             /* from here rc_rx_down() puts it all back */
+	rc_pic.valid = false;
+	uint32_t fbytes = rc_w * rc_h * 2;
+	for (uint32_t o = 0; o < fbytes; o += 4) {
+		*(volatile uint32_t *)(rc_ring + o) = 0xa5a5a5a5u;
+		*(volatile uint32_t *)(rc_ring + RC_SLOT + o) = 0xa5a5a5a5u;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");      /* the pattern in DRAM before the DMA can start */
+	/* SysMMU 0x140e0000 to bypass (CTRL_DISABLE), PHY isolation bypass (PMU 0x70c bit 0) and reset released (bit 1),
+	 * the four lane byte clocks from the PHY (user mux select 1, bit 12) */
+	rc_rx.mmu_ctrl = rc_rd(rc_mmu, 0);
+	rc_rx.iso = rc_rd(rc_pmu, 0x70c);
+	rc_rx.phyc = rc_rd(rc_phy, 0x40);
+	rc_wr(rc_mmu, 0, 0);
+	rc_wr(rc_pmu, 0x70c, rc_rx.iso | 1u);
+	rc_wr(rc_phy, 0x40, rc_rx.phyc & ~2u);
+	rc_wr(rc_phy, 0x40, rc_rx.phyc | 2u);
+	for (unsigned n = 0; n < 4; n++) {
+		rc_rx.rx_mux[n] = rc_rd(rc_cam0, 0x220 + 4 * n);
+		rc_wr(rc_cam0, 0x220 + 4 * n, rc_rx.rx_mux[n] | (1u << 12));
+	}
+	uint32_t settle = rc_o_settle ? rc_o_settle : rc_mode_settle;
+	bool deskew = rc_o_deskew == 2 ? true : rc_o_deskew == 1 ? false : rc_mode_deskew;
+	printf("rcam: stage 5: %u x %u RAW10, 4 lanes, settle %u (%s), deskew %s (%s); lane byte clock muxes %#x %#x %#x %#x -> "
+	    "%#x %#x %#x %#x; PHY %#x -> %#x, PMU 0x70c %#x -> %#x, SysMMU %#x -> %#x; CSIS0 version %#x\n", rc_w, rc_h, settle,
+	    rc_o_settle ? "kern.herolte_rcam_settle" : "Samsung's config_imx260 for this mode", deskew ? "on" : "off",
+	    rc_o_deskew ? "kern.herolte_rcam_deskew" : "Samsung: mipi_speed > 1500 only", rc_rx.rx_mux[0], rc_rx.rx_mux[1],
+	    rc_rx.rx_mux[2], rc_rx.rx_mux[3], rc_rd(rc_cam0, 0x220), rc_rd(rc_cam0, 0x224), rc_rd(rc_cam0, 0x228),
+	    rc_rd(rc_cam0, 0x22c), rc_rx.phyc, rc_rd(rc_phy, 0x40), rc_rx.iso, rc_rd(rc_pmu, 0x70c), rc_rx.mmu_ctrl,
+	    rc_rd(rc_mmu, 0), rc_rd(rc_csis, 0));
+	rc_csis_setup(settle, deskew);
+	printf("rcam: stage 5: CSIS0 set: CMN %#x DPHY_CMN %#x SCTRL_H %#x CH0 %#x/%#x, INT_MSK0 %#x MSK1 %#x, DMA0 ctrl %#x fmt "
+	    "%#x addr1 %#x addr2 %#x\n", rc_rd(rc_csis, 0x4), rc_rd(rc_csis, 0x24), rc_rd(rc_csis, 0x3c), rc_rd(rc_csis, 0x40),
+	    rc_rd(rc_csis, 0x44), rc_rd(rc_csis, 0x10), rc_rd(rc_csis, 0x18), rc_rd(rc_csis, 0x1000), rc_rd(rc_csis, 0x1004),
+	    rc_rd(rc_csis, 0x1010), rc_rd(rc_csis, 0x1014));
+	uint32_t f0 = rc_rd(rc_csis, 0x100);
+	rc_streaming = true;
+	bool on = rc_sensor_wr8(0x0100, 0x01);
+	uint64_t t0 = mach_absolute_time();
+	printf("rcam: stage 5: stream on (0x0100 = 1): %s; FRM_CNT_CH0 %u before\n", on ? "ok" : "NACK", f0);
+	uint32_t f = f0;
+	unsigned waited = 0;
+	for (; waited < 1000 && f == f0; waited += 2) {
+		rc_sleep_ms(2);
+		f = rc_rd(rc_csis, 0x100);
+	}
+	if (f != f0) {
+		/* the DMA cycles ADDR1-8: slot 0 out of the cycle from now, so the first frame stays (and the stream below is
+		 * short enough, ~150 ms, that even without this the pointer would not come back to ADDR1) */
+		rc_wr(rc_csis, 0x1010, RC_BUF + RC_SLOT);
+		printf("rcam: stage 5: FIRST FRAME after about %u ms (FRM_CNT_CH0 %u); DMA0 ADDR1 now slot 1 (%#x), active pointer %u\n",
+		    waited, f, rc_rd(rc_csis, 0x1010), (rc_rd(rc_csis, 0x1030) >> 2) & 7);
+	} else {
+		printf("rcam: stage 5: no frame counted in 1 s\n");
+	}
+	rc_csis_report("first");
+	rc_sleep_ms(150);
+	rc_csis_report("after 150 ms more");
+	uint32_t dma_bytes = rc_rd(rc_csis, 0x1040);
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	uint32_t f1 = rc_rd(rc_csis, 0x100);
+	printf("rcam: stage 5: %u frames counted in %llu ms; DMA0 active pointer %u (ADDR1 = slot 0 = the first frame)\n",
+	    f1 - f0, ns / 1000000, (rc_rd(rc_csis, 0x1030) >> 2) & 7);
+	if (!rc_o_keep) {
+		rc_stream_down();
+	} else {
+		printf("rcam: stage 5: kern.herolte_rcam_keep=1: still streaming (stage 0 stops it)\n");
+	}
+	rc_frame_stats("slot 0 (first frame)", rc_ring, fbytes, true);
+	rc_frame_stats("slot 1 (later frames)", rc_ring + RC_SLOT, fbytes, false);
+	rc_pic.dma_bytes = dma_bytes;
+	rc_pic.frames = f1 - f0;
+	rc_pic.mode = rc_w == 4032 ? 3 : 7;
+	printf("rcam: stage 5: frame export %s: %u bytes (kern.herolte_rcam_pic_info, kern.herolte_rcam_pic)\n",
+	    rc_pic.valid ? "ready" : "EMPTY", rc_pic.bytes);
+	printf("rcam: stage 5: the frame is at %#x (slot 0) and %#x (slot 1), %u x %u, 16 bits a pixel (RAW10 in 9:0)\n", RC_BUF,
+	    RC_BUF + RC_SLOT, rc_w, rc_h);
+	return f != f0;
+}
+
+/* ---- kern.herolte_rcam ---- */
+static int
+rc_run(int level)
+{
+	if (!rc_maps()) {
+		printf("rcam: map failed\n");
+		return ENXIO;
+	}
+	if (level == 0) {
+		rc_power_off();
+		rc_last = 0;
+		return 0;
+	}
+	for (int s = 1; s <= level; s++) {
+		bool ok = s == 1 ? rc_power_on() : s == 2 ? rc_probe() : s == 3 ? rc_firmware() : s == 4 ? rc_sensor_init() :
+		    rc_capture();
+		if (!ok) {
+			printf("rcam: stopped at stage %d (of %d); kern.herolte_rcam=0 powers everything down\n", s, level);
+			return EIO;
+		}
+		rc_last = s;
+	}
+	printf("rcam: stages 1-%d done\n", level);
+	return 0;
+}
+
+static int
+rc_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int value = rc_last;
+	int error = sysctl_handle_int(oidp, &value, 0, req);
+	if (error || req->newptr == USER_ADDR_NULL) {
+		return error;
+	}
+	if (!kauth_cred_issuser(kauth_cred_get())) {
+		return EPERM;
+	}
+	if (value < 0 || value > 5) {
+		return EINVAL;
+	}
+	printf("rcam: kern.herolte_rcam=%d by pid %d\n", value, proc_selfpid());
+	lck_mtx_lock(&rc_mtx);
+	error = rc_run(value);
+	lck_mtx_unlock(&rc_mtx);
+	return error;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, herolte_rcam, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    NULL, 0, rc_sysctl, "I", "rear camera IMX260 + C3: 0 off, 1 power, 2 I2C probe, 3 companion firmware, 4 sensor tables, 5 one frame");
+#endif /* ARM64_BOARD_CONFIG_HEROLTE */
