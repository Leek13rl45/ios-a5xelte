+
+/*
+ * iOS maps are 16K-page on this kernel (VM page 16K, >1 GB RAM) while Linux
+ * ELF objects and bionic's linker work in 4K pages. Requests that are not
+ * aligned to the map page are emulated: the covering map pages are made
+ * RWX (contents kept) and the 4K range is filled by copy (file) or zeroing.
+ * Partial-page protection changes widen to RWX and PROT_NONE is ignored.
+ */
+#define LX_RWX (PROT_READ | PROT_WRITE | PROT_EXEC)
+
+static uint64_t
+lx_pagemask(void)
+{
+	return vm_map_page_mask(current_map());
+}
+
+static int
+lx_open_pages(proc_t p, user_addr_t start, user_addr_t end)
+{
+	uint64_t psize = lx_pagemask() + 1;
+	for (user_addr_t a = start; a < end; a += psize) {
+		struct mprotect_args ma = { .addr = a, .len = psize, .prot = LX_RWX };
+		int32_t r;
+		if (mprotect(p, &ma, &r) != 0) {
+			struct mmap_args mm = {
+				.addr = a, .len = psize, .prot = LX_RWX,
+				.flags = MAP_ANON | MAP_PRIVATE | MAP_FIXED, .fd = -1, .pos = 0,
+			};
+			user_addr_t got = 0;
+			int error = mmap(p, &mm, &got);
+			if (error) {
+				return error;
+			}
+		}
+	}
+	return 0;
+}
+
+static int
+lx_fill(proc_t p, user_addr_t addr, uint64_t len, int fd, uint64_t off, bool anon)
+{
+	static const uint8_t zero[4096];
+	uint64_t done = 0;
+	while (done < len) {
+		uint64_t n = len - done;
+		if (anon) {
+			n = MIN(n, sizeof(zero));
+			if (copyout(zero, addr + done, n)) {
+				return EFAULT;
+			}
+		} else {
+			struct pread_args pa = { .fd = fd, .buf = addr + done, .nbyte = n, .offset = (off_t)(off + done) };
+			user_ssize_t got = 0;
+			int error = pread(p, &pa, &got);
+			if (error) {
+				return error;
+			}
+			if (got <= 0) {                 /* past EOF: Linux gives zeroes */
+				return lx_fill(p, addr + done, len - done, -1, 0, true);
+			}
+			n = (uint64_t)got;
+		}
+		done += n;
+	}
+	return 0;
 }
 
 static int64_t
+lx_mmap_emulated(proc_t p, uint64_t addr, uint64_t len, bool fixed, int fd, uint64_t off, bool anon)
+{
+	uint64_t pmask = lx_pagemask();
+	user_addr_t base = addr;
+	int error;
+	if (!fixed) {
+		struct mmap_args mm = {
+			.addr = 0, .len = (len + pmask) & ~pmask, .prot = LX_RWX,
+			.flags = MAP_ANON | MAP_PRIVATE, .fd = -1, .pos = 0,
+		};
+		error = mmap(p, &mm, &base);
+		if (error) {
+			return -lx_errno(error);
+		}
+	} else {
+		error = lx_open_pages(p, addr & ~pmask, (addr + len + pmask) & ~pmask);
+		if (error) {
+			return -lx_errno(error);
+		}
+	}
+	error = lx_fill(p, base, len, fd, off, anon);
+	if (error) {
+		return -lx_errno(error);
+	}
+	if (lx_trace >= 2) {
+		LXLOG("mmap emulated %#llx+%#llx fd %d off %#llx", base, len, anon ? -1 : fd, off);
+	}
+	return (int64_t)base;
+}
+
+static int64_t
 lx_mmap(proc_t p, uint64_t addr, uint64_t len, int prot, uint64_t lflags, int fd, uint64_t off)
 {
 	struct mmap_args ma = {};
