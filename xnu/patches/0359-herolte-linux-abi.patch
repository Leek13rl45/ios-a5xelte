+/*
+ * HEROLTE Linux arm64 ABI (bsd/dev/herolte_linux.c): the same lookups as the
+ * *at() system calls, but with paths that the Linux layer has already copied
+ * in and rewritten under its root prefix (kernel address space).
+ */
+int herolte_linux_openat(vfs_context_t ctx, int fd, const char *kpath, int flags, int mode, int *retval);
+int herolte_linux_faccessat(vfs_context_t ctx, int fd, const char *kpath, int amode);
+int herolte_linux_readlinkat(vfs_context_t ctx, int fd, const char *kpath, user_addr_t buf, size_t bufsize, int *retval);
+int herolte_linux_statat(vfs_context_t ctx, int fd, const char *kpath, int follow, struct stat64 *sb);
+int herolte_linux_mkdirat(vfs_context_t ctx, int fd, const char *kpath, int mode);
+int herolte_linux_unlinkat(vfs_context_t ctx, int fd, const char *kpath, int rmdir);
+
+int
+herolte_linux_openat(vfs_context_t ctx, int fd, const char *kpath, int flags, int mode, int *retval)
+{
+	return openat_internal(ctx, CAST_USER_ADDR_T(kpath), flags, mode, fd, UIO_SYSSPACE, retval);
+}
+
+int
+herolte_linux_faccessat(vfs_context_t ctx, int fd, const char *kpath, int amode)
+{
+	return faccessat_internal(ctx, fd, CAST_USER_ADDR_T(kpath), amode, 0, UIO_SYSSPACE);
+}
+
+int
+herolte_linux_readlinkat(vfs_context_t ctx, int fd, const char *kpath, user_addr_t buf, size_t bufsize, int *retval)
+{
+	return readlinkat_internal(ctx, fd, NULLVP, CAST_USER_ADDR_T(kpath), UIO_SYSSPACE,
+	           buf, bufsize, UIO_USERSPACE, retval);
+}
+
+int
+herolte_linux_statat(vfs_context_t ctx, int fd, const char *kpath, int follow, struct stat64 *sb)
+{
+	struct nameidata nd;
+	int error;
 
+	NDINIT(&nd, LOOKUP, OP_GETATTR, (follow ? FOLLOW : NOFOLLOW) | AUDITVNPATH1,
+	    UIO_SYSSPACE, CAST_USER_ADDR_T(kpath), ctx);
+	error = nameiat(&nd, fd);
+	if (error) {
+		return error;
+	}
+	error = vn_stat(nd.ni_vp, sb, NULL, 1, 0, ctx);
+	vnode_put(nd.ni_vp);
+	nameidone(&nd);
 	return error;
 }
+
+int
+herolte_linux_mkdirat(vfs_context_t ctx, int fd, const char *kpath, int mode)
+{
+	struct vnode_attr va;
+
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, (mode & ACCESSPERMS) & ~vfs_context_proc(ctx)->p_fd.fd_cmask);
+	return mkdir1at(ctx, CAST_USER_ADDR_T(kpath), &va, fd, UIO_SYSSPACE);
+}
+
+int
+herolte_linux_unlinkat(vfs_context_t ctx, int fd, const char *kpath, int rmdir)
+{
+	if (rmdir) {
+		return rmdirat_internal(ctx, fd, CAST_USER_ADDR_T(kpath), UIO_SYSSPACE, 0);
+	}
+	return unlinkat_internal(ctx, fd, NULLVP, CAST_USER_ADDR_T(kpath), UIO_SYSSPACE, 0);
+}
diff --git a/bsd/dev/herolte_linux.c b/bsd/dev/herolte_linux.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/herolte_linux.c
@@ -0,0 +1,1200 @@
+/*
+ * HEROLTE: Linux arm64 system call personality for unmodified Android ELF
+ * programs (vendor lhd/gpsd, bionic), see HEROLTE_PROGRESS.md.
+ *
+ * A Darwin loader (linuxrun) maps the ELF and its interpreter, builds a Linux
+ * initial stack and calls linux_enter(pc, sp) (Darwin syscall 556). From then
+ * on the thread is a Linux thread: `svc #0` with the number in x8 comes here
+ * instead of unix_syscall(), results go back in x0 as value or -errno, and
+ * TPIDR_EL0 holds the thread's own TLS pointer (osfmk/arm64 cswitch/locore).
+ *
+ * Paths: absolute Linux paths are looked up under LX_ROOT, except iOS paths
+ * (/private/..., /var/...) and a few /dev nodes that exist on both systems.
+ *
+ * Gated by the boot-arg linuxabi=1; linuxtrace=1 logs unimplemented calls and
+ * program output, linuxtrace=2 every call (bounded).
+ */
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <kern/assert.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <kern/kalloc.h>
+#include <mach/machine/thread_status.h>
+#include <mach/thread_act.h>
+#include <machine/machine_routines.h>
+#include <arm64/proc_reg.h>
+#include <pexpert/pexpert.h>
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/kernel.h>
+#include <sys/proc_internal.h>
+#include <sys/file_internal.h>
+#include <sys/vnode_internal.h>
+#include <sys/user.h>
+#include <sys/errno.h>
+#include <sys/sysproto.h>
+#include <sys/kauth.h>
+#include <sys/stat.h>
+#include <sys/fcntl.h>
+#include <sys/mman.h>
+#include <sys/ulock.h>
+#include <sys/random.h>
+#include <sys/filio.h>
+#include <sys/wait.h>
+#include <libkern/OSAtomic.h>
+
+#define LX_ROOT "/private/var/herolte/linux/root"
+
+/* Must match struct herolte_linux_thread in osfmk/arm/thread.h. */
+struct hl_thread {
+	uint64_t abi;
+	uint64_t tls;
+	uint64_t clear_tid;
+	uint64_t robust_list;
+	int32_t  tid;
+	int32_t  nr;
+};
+extern void *herolte_linux_thread(thread_t);
+extern const size_t herolte_linux_thread_size;
+
+extern void *find_user_regs(thread_t);
+extern kern_return_t thread_create_immovable(task_t, thread_t *);
+extern kern_return_t thread_set_wq_state64(thread_t, thread_state_t);
+extern int get_task_numacts(task_t);
+extern void thread_exception_return(void) __dead2;
+
+void herolte_linux_syscall(arm_saved_state_t *, thread_t, struct proc *);
+void herolte_linux_syscall_return(int) __dead2;
+
+/* bsd/vfs/vfs_syscalls.c */
+extern int herolte_linux_openat(vfs_context_t, int, const char *, int, int, int *);
+extern int herolte_linux_faccessat(vfs_context_t, int, const char *, int);
+extern int herolte_linux_readlinkat(vfs_context_t, int, const char *, user_addr_t, size_t, int *);
+extern int herolte_linux_statat(vfs_context_t, int, const char *, int, struct stat64 *);
+extern int herolte_linux_mkdirat(vfs_context_t, int, const char *, int);
+extern int herolte_linux_unlinkat(vfs_context_t, int, const char *, int);
+
+static int lx_enabled = -1;
+static int lx_trace;
+static volatile SInt32 lx_trace_budget = 3000;
+static volatile SInt32 lx_unimpl_budget = 300;
+static volatile SInt32 lx_next_tid = 200000;
+
+/* Executable path per Linux process, for /proc/self/exe (bionic's linker
+ * stats and resolves it). Few Linux processes run at once. */
+#define LX_EXE_SLOTS 16
+static struct {
+	pid_t pid;
+	char path[MAXPATHLEN];
+} lx_exe[LX_EXE_SLOTS];
+static unsigned lx_exe_next;
+static LCK_GRP_DECLARE(lx_lck_grp, "herolte_linux");
+static LCK_MTX_DECLARE(lx_exe_mtx, &lx_lck_grp);
+
+static bool
+lx_exe_get(pid_t pid, char *out, size_t size)
+{
+	bool found = false;
+	lck_mtx_lock(&lx_exe_mtx);
+	for (unsigned i = 0; i < LX_EXE_SLOTS; i++) {
+		if (lx_exe[i].pid == pid) {
+			strlcpy(out, lx_exe[i].path, size);
+			found = true;
+			break;
+		}
+	}
+	lck_mtx_unlock(&lx_exe_mtx);
+	return found;
+}
+
+static void
+lx_exe_set(pid_t pid, const char *path)
+{
+	unsigned slot = LX_EXE_SLOTS;
+	lck_mtx_lock(&lx_exe_mtx);
+	for (unsigned i = 0; i < LX_EXE_SLOTS; i++) {
+		if (lx_exe[i].pid == pid) {
+			slot = i;
+		}
+	}
+	if (slot == LX_EXE_SLOTS) {
+		slot = lx_exe_next++ % LX_EXE_SLOTS;
+	}
+	lx_exe[slot].pid = pid;
+	strlcpy(lx_exe[slot].path, path, sizeof(lx_exe[slot].path));
+	lck_mtx_unlock(&lx_exe_mtx);
+}
+
+/* "/proc/self/exe" or "/proc/<own pid>/exe" */
+static bool
+lx_is_proc_exe(const char *p)
+{
+	char own[32];
+	if (!strcmp(p, "/proc/self/exe")) {
+		return true;
+	}
+	snprintf(own, sizeof(own), "/proc/%d/exe", proc_pid(current_proc()));
+	return !strcmp(p, own);
+}
+
+#define LXLOG(fmt, ...) printf("LINUXABI[%d] " fmt "\n", proc_pid(current_proc()), ##__VA_ARGS__)
+
+static struct hl_thread *
+lx_thread(thread_t th)
+{
+	return (struct hl_thread *)herolte_linux_thread(th);
+}
+
+/* Darwin errno -> Linux errno. 1..34 are identical. */
+static int
+lx_errno(int e)
+{
+	switch (e) {
+	case EDEADLK: return 35;
+	case EAGAIN: return 11;
+	case EINPROGRESS: return 115;
+	case EALREADY: return 114;
+	case ENOTSOCK: return 88;
+	case EDESTADDRREQ: return 89;
+	case EMSGSIZE: return 90;
+	case EPROTOTYPE: return 91;
+	case ENOPROTOOPT: return 92;
+	case EPROTONOSUPPORT: return 93;
+	case ESOCKTNOSUPPORT: return 94;
+	case ENOTSUP: return 95;
+	case EPFNOSUPPORT: return 96;
+	case EAFNOSUPPORT: return 97;
+	case EADDRINUSE: return 98;
+	case EADDRNOTAVAIL: return 99;
+	case ENETDOWN: return 100;
+	case ENETUNREACH: return 101;
+	case ENETRESET: return 102;
+	case ECONNABORTED: return 103;
+	case ECONNRESET: return 104;
+	case ENOBUFS: return 105;
+	case EISCONN: return 106;
+	case ENOTCONN: return 107;
+	case ESHUTDOWN: return 108;
+	case ETOOMANYREFS: return 109;
+	case ETIMEDOUT: return 110;
+	case ECONNREFUSED: return 111;
+	case ELOOP: return 40;
+	case ENAMETOOLONG: return 36;
+	case EHOSTDOWN: return 112;
+	case EHOSTUNREACH: return 113;
+	case ENOTEMPTY: return 39;
+	case EUSERS: return 87;
+	case EDQUOT: return 122;
+	case ESTALE: return 116;
+	case ENOLCK: return 37;
+	case ENOSYS: return 38;
+	case EOVERFLOW: return 75;
+	case ECANCELED: return 125;
+	case EIDRM: return 43;
+	case ENOMSG: return 42;
+	case EILSEQ: return 84;
+	case EBADMSG: return 74;
+	case EMULTIHOP: return 72;
+	case ENODATA: return 61;
+	case ENOLINK: return 67;
+	case ENOSR: return 63;
+	case ENOSTR: return 60;
+	case EPROTO: return 71;
+	case ETIME: return 62;
+	case ENOTRECOVERABLE: return 131;
+	case EOWNERDEAD: return 130;
+	default:
+		return (e > 0 && e <= 34) ? e : 22 /* EINVAL */;
+	}
+}
+
+#define LX_EPERM   1
+#define LX_ENOENT  2
+#define LX_EINTR   4
+#define LX_EBADF   9
+#define LX_EAGAIN  11
+#define LX_ENOMEM  12
+#define LX_EFAULT  14
+#define LX_EEXIST  17
+#define LX_EINVAL  22
+#define LX_ENOTTY  25
+#define LX_ERANGE  34
+#define LX_ENOSYS  38
+#define LX_ETIMEDOUT 110
+
+/* --- flag translation ---------------------------------------------------- */
+
+#define LX_AT_FDCWD            (-100)
+#define LX_AT_SYMLINK_NOFOLLOW 0x100
+#define LX_AT_REMOVEDIR        0x200
+#define LX_AT_EMPTY_PATH       0x1000
+
+static int
+lx_dirfd(int64_t fd)
+{
+	return (int)fd == LX_AT_FDCWD ? AT_FDCWD : (int)fd;
+}
+
+static int
+lx_open_flags(uint64_t lf)
+{
+	int f = (int)(lf & 3);
+	if (lf & 0x40) {
+		f |= O_CREAT;
+	}
+	if (lf & 0x80) {
+		f |= O_EXCL;
+	}
+	if (lf & 0x100) {
+		f |= O_NOCTTY;
+	}
+	if (lf & 0x200) {
+		f |= O_TRUNC;
+	}
+	if (lf & 0x400) {
+		f |= O_APPEND;
+	}
+	if (lf & 0x800) {
+		f |= O_NONBLOCK;
+	}
+	if (lf & 0x1000) {
+		f |= O_DSYNC;
+	}
+	if (lf & 0x4000) {
+		f |= O_DIRECTORY;
+	}
+	if (lf & 0x8000) {
+		f |= O_NOFOLLOW;
+	}
+	if (lf & 0x80000) {
+		f |= O_CLOEXEC;
+	}
+	return f;
+}
+
+static int64_t
+lx_from_darwin_fl(int df)
+{
+	int64_t lf = df & 3;
+	if (df & O_APPEND) {
+		lf |= 0x400;
+	}
+	if (df & O_NONBLOCK) {
+		lf |= 0x800;
+	}
+	if (df & O_DSYNC) {
+		lf |= 0x1000;
+	}
+	return lf;
+}
+
+/* --- paths ---------------------------------------------------------------- */
+
+static bool
+lx_passthrough(const char *p)
+{
+	static const char *const keep[] = {
+		"/private/", "/var/", "/dev/null", "/dev/zero", "/dev/random", "/dev/urandom", "/dev/tty",
+	};
+	for (unsigned i = 0; i < sizeof(keep) / sizeof(keep[0]); i++) {
+		if (!strncmp(p, keep[i], strlen(keep[i]))) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Copy a Linux path in and rewrite it. *out is kalloc'ed MAXPATHLEN bytes.
+ * *is_exe tells readlinkat that the caller asked for /proc/self/exe. */
+static int
+lx_path_ex(user_addr_t upath, char **out, bool *is_exe)
+{
+	char *in, *res;
+	size_t len = 0;
+	int error;
+
+	in = kalloc_data(MAXPATHLEN, Z_WAITOK);
+	res = kalloc_data(MAXPATHLEN, Z_WAITOK);
+	if (!in || !res) {
+		kfree_data(in, MAXPATHLEN);
+		kfree_data(res, MAXPATHLEN);
+		return ENOMEM;
+	}
+	error = copyinstr(upath, in, MAXPATHLEN, &len);
+	if (is_exe) {
+		*is_exe = false;
+	}
+	if (!error) {
+		if (lx_is_proc_exe(in)) {
+			if (lx_exe_get(proc_pid(current_proc()), res, MAXPATHLEN)) {
+				if (is_exe) {
+					*is_exe = true;
+				}
+			} else {
+				error = ENOENT;
+			}
+		} else if (in[0] != '/' || lx_passthrough(in)) {
+			strlcpy(res, in, MAXPATHLEN);
+		} else if (strlen(LX_ROOT) + strlen(in) >= MAXPATHLEN) {
+			error = ENAMETOOLONG;
+		} else {
+			strlcpy(res, LX_ROOT, MAXPATHLEN);
+			strlcat(res, in, MAXPATHLEN);
+		}
+	}
+	kfree_data(in, MAXPATHLEN);
+	if (error) {
+		kfree_data(res, MAXPATHLEN);
+		return error;
+	}
+	*out = res;
+	return 0;
+}
+
+static int
+lx_path(user_addr_t upath, char **out)
+{
+	return lx_path_ex(upath, out, NULL);
+}
+
+static void
+lx_path_free(char *p)
+{
+	kfree_data(p, MAXPATHLEN);
+}
