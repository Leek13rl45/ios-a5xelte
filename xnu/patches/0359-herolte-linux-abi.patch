+
+struct lx_statfs {
+	int64_t f_type, f_bsize;
+	uint64_t f_blocks, f_bfree, f_bavail, f_files, f_ffree;
+	int32_t f_fsid[2];
+	int64_t f_namelen, f_frsize, f_flags, f_spare[4];
+};
+
+static int64_t
+lx_fake_statfs(user_addr_t ub)
+{
+	struct lx_statfs s = {
+		.f_type = 0xEF53, .f_bsize = 4096, .f_blocks = 1 << 20, .f_bfree = 1 << 19,
+		.f_bavail = 1 << 19, .f_files = 1 << 16, .f_ffree = 1 << 15, .f_namelen = 255,
+		.f_frsize = 4096,
+	};
+	return copyout(&s, ub, sizeof(s)) ? -LX_EFAULT : 0;
+}
+
+static int64_t
+lx_getrandom(user_addr_t ub, uint64_t len)
+{
+	uint8_t buf[256];
+	uint64_t done = 0;
+	while (done < len) {
+		u_int n = (u_int)MIN(len - done, sizeof(buf));
+		read_random(buf, n);
+		if (copyout(buf, ub + done, n)) {
+			return done ? (int64_t)done : -LX_EFAULT;
+		}
+		done += n;
+	}
+	return (int64_t)len;
+}
+
+static int64_t
+lx_mmap(proc_t p, uint64_t addr, uint64_t len, int prot, uint64_t lflags, int fd, uint64_t off)
+{
+	struct mmap_args ma = {};
+	user_addr_t rv = 0;
+	int flags = 0, error;
+	bool noreplace = (lflags & 0x100000) != 0;
+
+	switch (lflags & 0xf) {
+	case 1: flags = MAP_SHARED; break;
+	case 2: flags = MAP_PRIVATE; break;
+	case 3: flags = MAP_SHARED; break;      /* MAP_SHARED_VALIDATE */
+	default: return -LX_EINVAL;
+	}
+	if (lflags & 0x10) {
+		flags |= MAP_FIXED;
+	}
+	if (lflags & 0x20) {
+		flags |= MAP_ANON;
+		fd = -1;
+	}
+	ma.addr = addr;
+	ma.len = len;
+	ma.prot = prot & (PROT_READ | PROT_WRITE | PROT_EXEC);
+	ma.flags = flags;
+	ma.fd = fd;
+	ma.pos = (off_t)off;
+	error = mmap(p, &ma, &rv);
+	if (error) {
+		return -lx_errno(error);
+	}
+	if (noreplace && addr && rv != addr) {
+		struct munmap_args mu = { .addr = rv, .len = len };
+		int32_t r;
+		(void)munmap(p, &mu, &r);
+		return -LX_EEXIST;
+	}
+	return (int64_t)rv;
+}
+
+static int64_t
+lx_fcntl(proc_t p, int fd, int cmd, uint64_t arg)
+{
+	struct fcntl_args fa = { .fd = fd, .arg = arg };
+	int32_t rv = 0;
+	int error;
+	switch (cmd) {
+	case 0: fa.cmd = F_DUPFD; break;
+	case 1: fa.cmd = F_GETFD; break;
+	case 2: fa.cmd = F_SETFD; break;
+	case 3: fa.cmd = F_GETFL; break;
+	case 4: fa.cmd = F_SETFL; fa.arg = (uint64_t)lx_open_flags(arg) & ~(uint64_t)O_ACCMODE; break;
+	case 1030: fa.cmd = F_DUPFD_CLOEXEC; break;
+	case 5: case 6: case 7:                 /* F_GETLK/F_SETLK/F_SETLKW: single user */
+		if (cmd == 5) {
+			int16_t unlck = 2;              /* F_UNLCK in l_type (first field) */
+			(void)copyout(&unlck, arg, sizeof(unlck));
+		}
+		return 0;
+	default:
+		return -LX_EINVAL;
+	}
+	error = sys_fcntl(p, &fa, &rv);
+	if (error) {
+		return -lx_errno(error);
+	}
+	return cmd == 3 ? lx_from_darwin_fl(rv) : rv;
+}
+
+static int64_t
+lx_ioctl(proc_t p, int fd, uint64_t cmd, uint64_t arg)
+{
+	struct ioctl_args ia = { .fd = fd, .data = arg };
+	int32_t rv;
+	int error;
+	switch (cmd) {
+	case 0x5421: ia.com = FIONBIO; break;
+	case 0x541B: ia.com = FIONREAD; break;
+	default:
+		return -LX_ENOTTY;
+	}
+	error = ioctl(p, &ia, &rv);
+	return error ? -lx_errno(error) : 0;
+}
+
+/* --- dispatcher ------------------------------------------------------------ */
+
+static int64_t
+lx_dispatch(arm_saved_state_t *state, thread_t th, proc_t p, struct uthread *ut,
+    struct hl_thread *lt, int nr, const uint64_t *a)
+{
+	vfs_context_t ctx = vfs_context_current();
+	char *kp = NULL;
+	int error = 0;
+	int32_t ival = 0;
+	user_ssize_t sval = 0;
+	struct stat64 sb;
+
+	switch (nr) {
+	case 17: {                                      /* getcwd */
+		static const char cwd[] = "/";
+		if (a[1] < sizeof(cwd)) {
+			return -LX_ERANGE;
+		}
+		return copyout(cwd, a[0], sizeof(cwd)) ? -LX_EFAULT : (int64_t)sizeof(cwd);
+	}
+	case 23: {                                      /* dup */
+		struct dup_args da = { .fd = (u_int)a[0] };
+		error = sys_dup(p, &da, &ival);
+		return error ? -lx_errno(error) : ival;
+	}
+	case 24: {                                      /* dup3 */
+		struct dup2_args da = { .from = (u_int)a[0], .to = (u_int)a[1] };
+		error = sys_dup2(p, &da, &ival);
+		if (!error && (a[2] & 0x80000)) {
+			(void)lx_fcntl(p, (int)a[1], 2, 1);
+		}
+		return error ? -lx_errno(error) : ival;
+	}
+	case 25:                                        /* fcntl */
+		return lx_fcntl(p, (int)a[0], (int)a[1], a[2]);
+	case 29:                                        /* ioctl */
+		return lx_ioctl(p, (int)a[0], a[1], a[2]);
+	case 34:                                        /* mkdirat */
+		if ((error = lx_path(a[1], &kp)) == 0) {
+			error = herolte_linux_mkdirat(ctx, lx_dirfd(a[0]), kp, (int)a[2]);
+			lx_path_free(kp);
+		}
+		return error ? -lx_errno(error) : 0;
+	case 35:                                        /* unlinkat */
+		if ((error = lx_path(a[1], &kp)) == 0) {
+			error = herolte_linux_unlinkat(ctx, lx_dirfd(a[0]), kp, (a[2] & LX_AT_REMOVEDIR) != 0);
+			lx_path_free(kp);
+		}
+		return error ? -lx_errno(error) : 0;
+	case 43:                                        /* statfs */
+	case 44:                                        /* fstatfs */
+		return lx_fake_statfs(a[1]);
+	case 48:                                        /* faccessat */
+	case 439:                                       /* faccessat2 */
+		if ((error = lx_path(a[1], &kp)) == 0) {
+			error = herolte_linux_faccessat(ctx, lx_dirfd(a[0]), kp, (int)a[2] & 7);
+			lx_path_free(kp);
+		}
+		return error ? -lx_errno(error) : 0;
+	case 56:                                        /* openat */
+		if ((error = lx_path(a[1], &kp)) == 0) {
+			error = herolte_linux_openat(ctx, lx_dirfd(a[0]), kp, lx_open_flags(a[2]),
+			    (int)a[3], &ival);
+			if (lx_trace >= 2 || (error && lx_trace)) {
+				LXLOG("openat %s -> %d", kp, error ? -lx_errno(error) : ival);
+			}
+			lx_path_free(kp);
+		}
+		return error ? -lx_errno(error) : ival;
+	case 57: {                                      /* close */
+		struct close_args ca = { .fd = (int)a[0] };
+		error = sys_close(p, &ca, &ival);
+		return error ? -lx_errno(error) : 0;
+	}
+	case 62: {                                      /* lseek */
+		struct lseek_args la = { .fd = (int)a[0], .offset = (off_t)a[1], .whence = (int)a[2] };
+		off_t off = 0;
+		error = lseek(p, &la, &off);
+		return error ? -lx_errno(error) : (int64_t)off;
+	}
+	case 63: {                                      /* read */
+		struct read_args ra = { .fd = (int)a[0], .cbuf = a[1], .nbyte = a[2] };
+		error = read(p, &ra, &sval);
+		return error ? -lx_errno(error) : sval;
+	}
+	case 64: {                                      /* write */
+		struct write_args wa = { .fd = (int)a[0], .cbuf = a[1], .nbyte = a[2] };
+		if (lx_trace && (a[0] == 1 || a[0] == 2)) {
+			char line[161];
+			size_t n = MIN(a[2], sizeof(line) - 1);
+			if (!copyin(a[1], line, n)) {
+				line[n] = 0;
+				if (n && line[n - 1] == '\n') {
+					line[n - 1] = 0;
+				}
+				LXLOG("out%d: %s", (int)a[0], line);
+			}
+		}
+		error = write(p, &wa, &sval);
+		return error ? -lx_errno(error) : sval;
+	}
+	case 65: {                                      /* readv */
+		struct readv_args ra = { .fd = (int)a[0], .iovp = a[1], .iovcnt = (u_int)a[2] };
+		error = readv(p, &ra, &sval);
+		return error ? -lx_errno(error) : sval;
+	}
+	case 66: {                                      /* writev */
+		struct writev_args wa = { .fd = (int)a[0], .iovp = a[1], .iovcnt = (u_int)a[2] };
+		error = writev(p, &wa, &sval);
+		return error ? -lx_errno(error) : sval;
+	}
+	case 67: {                                      /* pread64 */
+		struct pread_args pa = { .fd = (int)a[0], .buf = a[1], .nbyte = a[2], .offset = (off_t)a[3] };
+		error = pread(p, &pa, &sval);
+		return error ? -lx_errno(error) : sval;
+	}
+	case 68: {                                      /* pwrite64 */
+		struct pwrite_args pa = { .fd = (int)a[0], .buf = a[1], .nbyte = a[2], .offset = (off_t)a[3] };
+		error = pwrite(p, &pa, &sval);
+		return error ? -lx_errno(error) : sval;
+	}
+	case 78: {                                      /* readlinkat */
+		bool is_exe;
+		if ((error = lx_path_ex(a[1], &kp, &is_exe)) == 0) {
+			if (is_exe) {
+				size_t n = MIN(strlen(kp), a[3]);
+				error = copyout(kp, a[2], n);
+				ival = (int32_t)n;
+			} else {
+				error = herolte_linux_readlinkat(ctx, lx_dirfd(a[0]), kp, a[2], a[3], &ival);
+			}
+			lx_path_free(kp);
+		}
+		return error ? -lx_errno(error) : ival;
+	}
+	case 79: {                                      /* newfstatat */
+		char empty = 1;
+		if (a[3] & LX_AT_EMPTY_PATH) {
+			(void)copyin(a[1], &empty, 1);
+		}
+		if ((a[3] & LX_AT_EMPTY_PATH) && empty == 0) {
+			error = lx_fstat_fd(p, (int)a[0], &sb);
+		} else if ((error = lx_path(a[1], &kp)) == 0) {
+			error = herolte_linux_statat(ctx, lx_dirfd(a[0]), kp,
+			    !(a[3] & LX_AT_SYMLINK_NOFOLLOW), &sb);
+			lx_path_free(kp);
+		}
+		if (error) {
+			return -lx_errno(error);
+		}
+		return lx_copyout_stat(&sb, a[2]) ? -LX_EFAULT : 0;
+	}
+	case 80:                                        /* fstat */
+		error = lx_fstat_fd(p, (int)a[0], &sb);
+		if (error) {
+			return -lx_errno(error);
+		}
+		return lx_copyout_stat(&sb, a[1]) ? -LX_EFAULT : 0;
+	case 93:                                        /* exit (thread) */
+		lx_clear_child_tid(p, ut, lt);
+		if (get_task_numacts(current_task()) <= 1) {
+			lx_exit_group(p, (int)a[0]);
+		}
+		lt->abi = 0;
+		thread_terminate(th);
+		return 0;
+	case 94:                                        /* exit_group */
+		lx_exit_group(p, (int)a[0]);
+	case 96:                                        /* set_tid_address */
+		lt->clear_tid = a[0];
+		return lt->tid;
+	case 98:                                        /* futex */
+		return lx_futex(p, ut, a[0], (int)a[1], (uint32_t)a[2], a[3]);
+	case 99:                                        /* set_robust_list */
+		lt->robust_list = a[0];
+		return 0;
+	case 101:                                       /* nanosleep */
+		return lx_nanosleep(1, 0, a[0]);
+	case 113: {                                     /* clock_gettime */
+		struct lx_timespec ts;
+		lx_clock((int)a[0], &ts);
+		return copyout(&ts, a[1], sizeof(ts)) ? -LX_EFAULT : 0;
+	}
+	case 114: {                                     /* clock_getres */
+		struct lx_timespec ts = { 0, 1 };
+		return (a[1] && copyout(&ts, a[1], sizeof(ts))) ? -LX_EFAULT : 0;
+	}
+	case 115:                                       /* clock_nanosleep */
+		return lx_nanosleep((int)a[0], (int)a[1], a[2]);
+	case 120:                                       /* sched_getscheduler */
+	case 121:                                       /* sched_getparam */
+	case 124:                                       /* sched_yield */
+	case 140:                                       /* setpriority */
+	case 141:                                       /* getpriority */
+		return 0;
+	case 123: {                                     /* sched_getaffinity */
+		uint64_t mask = 0xff;
+		if (a[1] < sizeof(mask)) {
+			return -LX_EINVAL;
+		}
+		return copyout(&mask, a[2], sizeof(mask)) ? -LX_EFAULT : (int64_t)sizeof(mask);
+	}
+	case 129:                                       /* kill */
+	case 130:                                       /* tkill */
+	case 131:                                       /* tgkill */
+		return 0;                               /* no Linux signals yet */
+	case 132:                                       /* sigaltstack */
+		if (a[1]) {
+			struct { uint64_t sp; int32_t flags; int32_t pad; uint64_t size; } old = { 0, 2, 0, 0 };
+			if (copyout(&old, a[1], sizeof(old))) {
+				return -LX_EFAULT;
+			}
+		}
+		return 0;
+	case 134:                                       /* rt_sigaction */
+		if (a[2]) {
+			uint64_t zero[4] = {};
+			if (copyout(zero, a[2], sizeof(zero))) {
+				return -LX_EFAULT;
+			}
+		}
+		return 0;
+	case 135:                                       /* rt_sigprocmask */
+		if (a[2]) {
+			uint64_t zero = 0;
+			if (copyout(&zero, a[2], sizeof(zero))) {
+				return -LX_EFAULT;
+			}
+		}
+		return 0;
+	case 160:                                       /* uname */
+		return lx_uname(a[0]);
+	case 166: {                                     /* umask */
+		struct umask_args ua = { .newmask = (int)a[0] };
+		error = umask(p, &ua, &ival);
+		return error ? -lx_errno(error) : ival;
+	}
+	case 167:                                       /* prctl */
+		switch (a[0]) {
+		case 3:                                 /* PR_GET_DUMPABLE */
+			return 1;
+		case 4:                                 /* PR_SET_DUMPABLE */
+		case 15:                                /* PR_SET_NAME */
+		case 38:                                /* PR_SET_NO_NEW_PRIVS */
+			return 0;
+		case 16: {                              /* PR_GET_NAME */
+			char name[16] = {};
+			strlcpy(name, p->p_comm, sizeof(name));
+			return copyout(name, a[1], sizeof(name)) ? -LX_EFAULT : 0;
+		}
+		default:                                /* PR_SET_VMA and others */
+			return -LX_EINVAL;
+		}
+	case 172:                                       /* getpid */
+		return proc_pid(p);
+	case 173:                                       /* getppid */
+		return proc_ppid(p);
+	case 174:                                       /* getuid */
+		return kauth_getruid();
+	case 175:                                       /* geteuid */
+		return kauth_getuid();
+	case 176:                                       /* getgid */
+		return kauth_getrgid();
+	case 177:                                       /* getegid */
+		return kauth_getgid();
+	case 178:                                       /* gettid */
+		return lt->tid;
+	case 215: {                                     /* munmap */
+		struct munmap_args mu = { .addr = a[0], .len = a[1] };
+		error = munmap(p, &mu, &ival);
+		return error ? -lx_errno(error) : 0;
+	}
+	case 220:                                       /* clone */
+		return lx_clone(state, a[0], a[1], a[2], a[3], a[4]);
+	case 222:                                       /* mmap */
+		return lx_mmap(p, a[0], a[1], (int)a[2], a[3], (int)a[4], a[5]);
+	case 226: {                                     /* mprotect */
+		struct mprotect_args ma = { .addr = a[0], .len = a[1], .prot = (int)a[2] & 7 };
+		error = mprotect(p, &ma, &ival);
+		return error ? -lx_errno(error) : 0;
+	}
+	case 233:                                       /* madvise */
+		return 0;
+	case 261:                                       /* prlimit64 */
+		if (a[3]) {
+			uint64_t lim[2] = { 8 << 20, UINT64_MAX };
+			if (a[1] == 7) {                        /* RLIMIT_NOFILE */
+				lim[0] = lim[1] = 1024;
+			}
+			if (copyout(lim, a[3], sizeof(lim))) {
+				return -LX_EFAULT;
+			}
+		}
+		return 0;
+	case 278:                                       /* getrandom */
+		return lx_getrandom(a[0], a[1]);
+	default:
+		if (OSDecrementAtomic(&lx_unimpl_budget) > 0) {
+			LXLOG("unimplemented nr %d (%#llx, %#llx, %#llx) pc %#llx", nr, a[0], a[1], a[2],
+			    saved_state64(state)->pc);
+		}
+		return -LX_ENOSYS;
+	}
+}
+
+void
+herolte_linux_syscall(arm_saved_state_t *state, thread_t th, struct proc *p)
+{
+	struct arm_saved_state64 *ss = saved_state64(state);
+	struct uthread *ut = get_bsdthread_info(th);
+	struct hl_thread *lt = lx_thread(th);
+	uint64_t a[6] = { ss->x[0], ss->x[1], ss->x[2], ss->x[3], ss->x[4], ss->x[5] };
+	int nr = (int)ss->x[8];
+	int64_t ret;
+
+	lt->nr = nr;
+	ut->uu_flag |= UT_NOTCANCELPT;
+	ut->syscall_code = 0;
+	ut->uu_rval[0] = ut->uu_rval[1] = 0;
+
+	ret = lx_dispatch(state, th, p, ut, lt, nr, a);
+
+	if (lx_trace >= 2 && OSDecrementAtomic(&lx_trace_budget) > 0) {
+		LXLOG("tid %d nr %d (%#llx, %#llx, %#llx) = %lld", lt->tid, nr, a[0], a[1], a[2], ret);
+	}
+	ss->x[0] = (uint64_t)ret;
+	ut->uu_flag &= ~UT_NOTCANCELPT;
+}
+
+/* Continuation return (ulock_wait, select, ...): see unix_syscall_return(). */
+void
+herolte_linux_syscall_return(int error)
+{
+	thread_t th = current_thread();
+	struct uthread *ut = get_bsdthread_info(th);
+	struct hl_thread *lt = lx_thread(th);
+	struct arm_saved_state64 *ss = saved_state64((arm_saved_state_t *)find_user_regs(th));
+
+	if (error == ERESTART) {
+		ss->pc -= 4;
+	} else if (error != EJUSTRETURN) {
+		int64_t ret;
+		if (error) {
+			ret = -lx_errno(error);
+		} else if (lt->nr == 98) {              /* futex wait woke */
+			ret = 0;
+		} else {
+			ret = (int64_t)ut->uu_rval[0];
+		}
+		ss->x[0] = (uint64_t)ret;
+	}
+	ut->uu_flag &= ~UT_NOTCANCELPT;
+	ut->syscall_code = 0;
+	thread_exception_return();
+}
+
+/* Darwin syscall 556: become a Linux thread at pc with stack sp. */
+int
+linux_enter(proc_t p, struct linux_enter_args *uap, __unused int32_t *retval)
+{
+	thread_t th = current_thread();
+	struct hl_thread *lt = lx_thread(th);
+	struct arm_saved_state64 *ss;
+	int enabled = 0;
+	char *exe;
+	size_t len = 0;
+
+	if (lx_enabled < 0) {
+		PE_parse_boot_argn("linuxtrace", &lx_trace, sizeof(lx_trace));
+		lx_enabled = PE_parse_boot_argn("linuxabi", &enabled, sizeof(enabled)) && enabled == 1;
+	}
+	if (!lx_enabled) {
+		return ENOSYS;
+	}
+	if (herolte_linux_thread_size != sizeof(struct hl_thread)) {
+		printf("LINUXABI: thread state size mismatch %lu != %lu\n",
+		    (unsigned long)herolte_linux_thread_size, sizeof(struct hl_thread));
+		return ENOSYS;
+	}
+	if (get_task_numacts(current_task()) != 1) {
+		return EBUSY;                           /* single-threaded loaders only */
+	}
+	exe = kalloc_data(MAXPATHLEN, Z_WAITOK);
+	if (!exe) {
+		return ENOMEM;
+	}
+	if (copyinstr(uap->exe, exe, MAXPATHLEN, &len) || exe[0] != '/') {
+		kfree_data(exe, MAXPATHLEN);
+		return EINVAL;
+	}
+	lx_exe_set(proc_pid(p), exe);
+	kfree_data(exe, MAXPATHLEN);
+
+	ss = saved_state64((arm_saved_state_t *)find_user_regs(th));
+	for (int i = 0; i < 29; i++) {
+		ss->x[i] = 0;
+	}
+	ss->fp = 0;
+	ss->lr = 0;
+	ss->sp = uap->sp;
+	ss->pc = uap->pc;
+	ss->cpsr &= ~(uint32_t)PSR64_NZCV_MASK;
+
+	lt->tls = 0;
+	lt->clear_tid = 0;
+	lt->robust_list = 0;
+	lt->tid = proc_pid(p);
+	lt->abi = 1;
+	__builtin_arm_wsr64("TPIDR_EL0", 0);
+	printf("LINUXABI[%d] enter %s pc %#llx sp %#llx\n", proc_pid(p), p->p_comm, uap->pc, uap->sp);
+	return EJUSTRETURN;
+}
