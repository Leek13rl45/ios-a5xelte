+/* --- stat ----------------------------------------------------------------- */
+
+struct lx_stat {
+	uint64_t st_dev;
+	uint64_t st_ino;
+	uint32_t st_mode;
+	uint32_t st_nlink;
+	uint32_t st_uid;
+	uint32_t st_gid;
+	uint64_t st_rdev;
+	uint64_t pad1;
+	int64_t  st_size;
+	int32_t  st_blksize;
+	int32_t  pad2;
+	int64_t  st_blocks;
+	int64_t  st_atime_sec;
+	int64_t  st_atime_nsec;
+	int64_t  st_mtime_sec;
+	int64_t  st_mtime_nsec;
+	int64_t  st_ctime_sec;
+	int64_t  st_ctime_nsec;
+	uint32_t unused[2];
+};
+_Static_assert(sizeof(struct lx_stat) == 128, "Linux arm64 struct stat");
+
+static int
+lx_copyout_stat(const struct stat64 *sb, user_addr_t ub)
+{
+	struct lx_stat ls = {
+		.st_dev = (uint32_t)sb->st_dev,
+		.st_ino = sb->st_ino,
+		.st_mode = sb->st_mode,
+		.st_nlink = sb->st_nlink,
+		.st_uid = sb->st_uid,
+		.st_gid = sb->st_gid,
+		.st_rdev = (uint32_t)sb->st_rdev,
+		.st_size = sb->st_size,
+		.st_blksize = sb->st_blksize,
+		.st_blocks = sb->st_blocks,
+		.st_atime_sec = sb->st_atimespec.tv_sec,
+		.st_atime_nsec = sb->st_atimespec.tv_nsec,
+		.st_mtime_sec = sb->st_mtimespec.tv_sec,
+		.st_mtime_nsec = sb->st_mtimespec.tv_nsec,
+		.st_ctime_sec = sb->st_ctimespec.tv_sec,
+		.st_ctime_nsec = sb->st_ctimespec.tv_nsec,
+	};
+	return copyout(&ls, ub, sizeof(ls));
+}
+
+static int
+lx_fstat_fd(proc_t p, int fd, struct stat64 *sb)
+{
+	struct fileproc *fp;
+	int error = fp_lookup(p, fd, &fp, 0);
+	if (error) {
+		return error;
+	}
+	bzero(sb, sizeof(*sb));
+	switch (FILEGLOB_DTYPE(fp->fp_glob)) {
+	case DTYPE_VNODE: {
+		vnode_t vp = (vnode_t)fp_get_data(fp);
+		error = vnode_getwithref(vp);
+		if (!error) {
+			error = vn_stat(vp, sb, NULL, 1, 0, vfs_context_current());
+			vnode_put(vp);
+		}
+		break;
+	}
+	case DTYPE_SOCKET:
+		sb->st_mode = S_IFSOCK | 0777;
+		sb->st_blksize = 4096;
+		break;
+	case DTYPE_PIPE:
+		sb->st_mode = S_IFIFO | 0600;
+		sb->st_blksize = 4096;
+		break;
+	default:
+		sb->st_mode = S_IFCHR | 0600;
+		break;
+	}
+	fp_drop(p, fd, fp, 0);
+	return error;
+}
+
+/* --- time ----------------------------------------------------------------- */
+
+struct lx_timespec {
+	int64_t tv_sec;
+	int64_t tv_nsec;
+};
+
+static void
+lx_clock(int clk, struct lx_timespec *ts)
+{
+	uint64_t ns;
+	if (clk == 0 || clk == 5 || clk == 8) {         /* REALTIME, _COARSE, _ALARM */
+		struct timespec now;
+		nanotime(&now);
+		ts->tv_sec = now.tv_sec;
+		ts->tv_nsec = now.tv_nsec;
+		return;
+	}
+	if (clk == 7 || clk == 9) {                     /* BOOTTIME (incl. sleep) */
+		absolutetime_to_nanoseconds(mach_continuous_time(), &ns);
+	} else {                                        /* MONOTONIC*, CPUTIME approx. */
+		absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	}
+	ts->tv_sec = (int64_t)(ns / NSEC_PER_SEC);
+	ts->tv_nsec = (int64_t)(ns % NSEC_PER_SEC);
+}
+
+/* Interruptible sleep until deadline (mach absolute time). */
+static int
+lx_sleep_until(uint64_t deadline)
+{
+	int event;
+	wait_result_t wr = assert_wait_deadline(&event, THREAD_ABORTSAFE, deadline);
+	if (wr == THREAD_WAITING) {
+		wr = thread_block(THREAD_CONTINUE_NULL);
+	}
+	return wr == THREAD_INTERRUPTED ? EINTR : 0;
+}
+
+static int64_t
+lx_nanosleep(int clk, int flags, user_addr_t ureq)
+{
+	struct lx_timespec req, now;
+	uint64_t ns, deadline, interval;
+	if (copyin(ureq, &req, sizeof(req))) {
+		return -LX_EFAULT;
+	}
+	if (req.tv_sec < 0 || req.tv_nsec < 0 || req.tv_nsec >= (int64_t)NSEC_PER_SEC) {
+		return -LX_EINVAL;
+	}
+	ns = (uint64_t)req.tv_sec * NSEC_PER_SEC + (uint64_t)req.tv_nsec;
+	if (flags & 1) {                                /* TIMER_ABSTIME */
+		uint64_t cur;
+		lx_clock(clk, &now);
+		cur = (uint64_t)now.tv_sec * NSEC_PER_SEC + (uint64_t)now.tv_nsec;
+		ns = ns > cur ? ns - cur : 0;
+	}
+	nanoseconds_to_absolutetime(ns, &interval);
+	clock_absolutetime_interval_to_deadline(interval, &deadline);
+	return lx_sleep_until(deadline) ? -LX_EINTR : 0;
+}
+
+/* --- futex ----------------------------------------------------------------- */
+
+static int64_t
+lx_futex(proc_t p, struct uthread *ut, user_addr_t uaddr, int op, uint32_t val, user_addr_t utime)
+{
+	int cmd = op & 0x7f;
+	int error;
+	if (cmd == 0 || cmd == 9) {                     /* FUTEX_WAIT, FUTEX_WAIT_BITSET */
+		struct ulock_wait_args ua = {
+			.operation = UL_COMPARE_AND_WAIT,
+			.addr = uaddr,
+			.value = val,
+			.timeout = 0,
+		};
+		if (utime) {
+			struct lx_timespec ts;
+			uint64_t us;
+			if (copyin(utime, &ts, sizeof(ts))) {
+				return -LX_EFAULT;
+			}
+			if (cmd == 9) {                         /* absolute */
+				struct lx_timespec now;
+				int64_t d;
+				lx_clock((op & 256) ? 0 : 1, &now);
+				d = (ts.tv_sec - now.tv_sec) * 1000000 + (ts.tv_nsec - now.tv_nsec) / 1000;
+				if (d <= 0) {
+					return -LX_ETIMEDOUT;
+				}
+				us = (uint64_t)d;
+			} else {
+				us = (uint64_t)ts.tv_sec * 1000000 + (uint64_t)ts.tv_nsec / 1000;
+				if (us == 0) {
+					us = 1;
+				}
+			}
+			ua.timeout = us > UINT32_MAX ? UINT32_MAX : (uint32_t)us;
+		}
+		error = sys_ulock_wait(p, &ua, (int *)&ut->uu_rval[0]);
+		/* A changed value returns at once with success; bionic retries. */
+		return error ? -lx_errno(error) : 0;
+	}
+	if (cmd == 1 || cmd == 10) {                    /* FUTEX_WAKE, FUTEX_WAKE_BITSET */
+		struct ulock_wake_args wa = {
+			.operation = UL_COMPARE_AND_WAIT | (val > 1 ? ULF_WAKE_ALL : 0),
+			.addr = uaddr,
+			.wake_value = 0,
+		};
+		if (val == 0) {
+			return 0;
+		}
+		error = sys_ulock_wake(p, &wa, (int *)&ut->uu_rval[0]);
+		return error == 0 ? 1 : 0;              /* ENOENT: nobody waiting */
+	}
+	return -LX_ENOSYS;
+}
+
+/* --- threads and exit ------------------------------------------------------ */
+
+#define LX_CLONE_VM             0x00000100
+#define LX_CLONE_THREAD         0x00010000
+#define LX_CLONE_SETTLS         0x00080000
+#define LX_CLONE_PARENT_SETTID  0x00100000
+#define LX_CLONE_CHILD_CLEARTID 0x00200000
+#define LX_CLONE_CHILD_SETTID   0x01000000
+
+static int64_t
+lx_clone(arm_saved_state_t *state, uint64_t flags, user_addr_t newsp, user_addr_t ptid,
+    uint64_t tls, user_addr_t ctid)
+{
+	struct arm_saved_state64 *ps = saved_state64(state);
+	arm_thread_state64_t ts = {};
+	struct hl_thread *child;
+	thread_t th;
+	int32_t tid;
+
+	if ((flags & (LX_CLONE_VM | LX_CLONE_THREAD)) != (LX_CLONE_VM | LX_CLONE_THREAD)) {
+		LXLOG("clone flags %#llx (process) unsupported", flags);
+		return -LX_ENOSYS;
+	}
+	if (thread_create_immovable(current_task(), &th) != KERN_SUCCESS) {
+		return -LX_EAGAIN;
+	}
+	for (int i = 0; i < 29; i++) {
+		ts.x[i] = ps->x[i];
+	}
+	ts.x[0] = 0;
+	ts.fp = ps->fp;
+	ts.lr = ps->lr;
+	ts.sp = newsp ? newsp : ps->sp;
+	ts.pc = ps->pc;
+	ts.cpsr = ps->cpsr;
+	(void)thread_set_wq_state64(th, (thread_state_t)&ts);
+
+	tid = OSIncrementAtomic(&lx_next_tid);
+	child = lx_thread(th);
+	child->tls = (flags & LX_CLONE_SETTLS) ? tls : __builtin_arm_rsr64("TPIDR_EL0");
+	child->tid = tid;
+	child->clear_tid = (flags & LX_CLONE_CHILD_CLEARTID) ? ctid : 0;
+	child->robust_list = 0;
+	child->abi = 1;
+	if (flags & LX_CLONE_PARENT_SETTID) {
+		(void)copyout(&tid, ptid, sizeof(tid));
+	}
+	if (flags & LX_CLONE_CHILD_SETTID) {
+		(void)copyout(&tid, ctid, sizeof(tid));
+	}
+	thread_resume(th);
+	thread_deallocate(th);
+	return tid;
+}
+
+static void
+lx_clear_child_tid(proc_t p, struct uthread *ut, struct hl_thread *lt)
+{
+	if (lt->clear_tid) {
+		int32_t zero = 0;
+		if (!copyout(&zero, lt->clear_tid, sizeof(zero))) {
+			(void)lx_futex(p, ut, lt->clear_tid, 1, INT32_MAX, 0);
+		}
+		lt->clear_tid = 0;
+	}
+}
+
+__dead2 static void
+lx_exit_group(proc_t p, int code)
+{
+	struct exit_args ea = { .rval = code & 0xff };
+	int32_t rv;
+	if (lx_trace) {
+		LXLOG("exit_group(%d)", code & 0xff);
+	}
+	exit(p, &ea, &rv);
+	__builtin_unreachable();
+}
