+/* App-facing rear capture. Called only after the front stream is stopped. */
+static uint32_t rc_previous_mode;
+int
+herolte_rcam_dev_start(void)
+{
+	lck_mtx_lock(&rc_mtx);
+	if (rc_live && rc_streaming) {
+		lck_mtx_unlock(&rc_mtx);
+		return 0;
+	}
+	if (!rc_fw || !rc_fw_len) {
+		printf("rcam: device: companion firmware has not been loaded\n");
+		lck_mtx_unlock(&rc_mtx);
+		return ENOENT;
+	}
+	if (rc_powered)
+		rc_power_off();
+	rc_previous_mode = rc_o_mode;
+	rc_o_mode = 7;
+	rc_live = true;
+	rc_seq = 0;
+	int error = rc_run(5);
+	if (!error) {
+		rc_frame_seen = rc_rd(rc_csis, 0x100);
+		printf("rcam: device: IMX260 live stream ready, 2016x1512\n");
+	} else {
+		rc_power_off();
+		rc_last = 0;
+		rc_live = false;
+		rc_o_mode = rc_previous_mode;
+	}
+	lck_mtx_unlock(&rc_mtx);
+	return error;
+}
+
+void
+herolte_rcam_dev_stop(void)
+{
+	lck_mtx_lock(&rc_mtx);
+	if (rc_live) {
+		rc_power_off();
+		rc_last = 0;
+		rc_live = false;
+		rc_o_mode = rc_previous_mode;
+		printf("rcam: device: stopped after %llu reads\n", rc_seq);
+	}
+	lck_mtx_unlock(&rc_mtx);
+}
+
+int
+herolte_rcam_dev_exposure(uint32_t lines, uint32_t gain)
+{
+	lck_mtx_lock(&rc_mtx);
+	int error = rc_live && rc_streaming ? rc_apply_exposure(lines, gain) : EIO;
+	lck_mtx_unlock(&rc_mtx);
+	return error;
+}
+
+int
+herolte_rcam_dev_read(struct uio *uio)
+{
+	_Static_assert(4 * RC_LIVE_SLOT <= RC_MAP_LEN, "live ring fits reserved camera memory");
+	lck_mtx_lock(&rc_mtx);
+	int error = 0;
+	if (!rc_live || !rc_streaming) {
+		error = EIO;
+		goto out;
+	}
+	bool pixels = uio_resid(uio) > (user_ssize_t)sizeof(struct nc_cam_frame);
+	if (pixels && !rc_copy) {
+		rc_copy = kalloc_data(RC_LIVE_BYTES, Z_WAITOK);
+		if (!rc_copy) {
+			error = ENOMEM;
+			goto out;
+		}
+	}
+	if (!rc_cached)
+		rc_cached = notefe_physmap_cached(RC_BUF, RC_MAP_LEN);
+	uint32_t f = rc_frame_seen, act = 0, slot = 0;
+	bool stable = false;
+	for (unsigned retry = 0; retry < 3 && !stable; retry++) {
+		for (unsigned waited = 0; waited < 500 && f == rc_frame_seen; waited++) {
+			rc_sleep_ms(2);
+			f = rc_rd(rc_csis, 0x100);
+		}
+		if (f == rc_frame_seen) {
+			error = ETIMEDOUT;
+			goto out;
+		}
+		rc_frame_seen = f;
+		act = (rc_rd(rc_csis, 0x1030) >> 2) & 7;
+		slot = ((act + 7) & 7) & 3;
+		if (pixels) {
+			vm_offset_t source = (rc_cached ? rc_cached : rc_ring) + slot * RC_LIVE_SLOT;
+			if (rc_cached)
+				flush_dcache(source, RC_LIVE_BYTES, 0);
+			bcopy((const void *)source, rc_copy, RC_LIVE_BYTES);
+			/* Do not export a snapshot whose slot could have been reused.
+			 * Copy before uiomove, which may fault or sleep in the caller. */
+			stable = rc_rd(rc_csis, 0x100) - f < 3;
+		} else {
+			stable = true;
+		}
+	}
+	if (!stable) {
+		error = EAGAIN;
+		goto out;
+	}
+	struct nc_cam_frame header = {
+		.magic = "RWFRAME1", .header_bytes = sizeof(header), .width = 2016, .height = 1512,
+		.stride = 2520, .format = 1, .bayer = rc_bayer & 3, .black = 64,
+		.sequence = ++rc_seq, .time = mach_absolute_time(), .exposure_lines = rc_exp,
+		.line_ns = 20833, .gain = rc_gain, .gain_unity = 32, .gain_max = 512,
+		.frame_lines = 1600, .frame_lines_min = 1600, .frame_lines_max = 1600, .margin = 16,
+		.sensor = 1, .focus = 0xffffffffu, .reserved = { slot, act, f, 0, 0 }
