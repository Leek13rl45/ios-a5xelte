@@ -0,0 +1,21 @@
+#ifndef HEROLTE_CAMERA_H
+#define HEROLTE_CAMERA_H
+#include <sys/types.h>
+struct uio;
+/* Shared with gpu/camera/hakios.camera.h; the RAW payload is packed MIPI RAW10. */
+struct nc_cam_frame {
+	char magic[8];
+	uint32_t header_bytes, width, height, stride, format, bayer, black;
+	uint64_t sequence, time;
+	uint32_t exposure_lines, line_ns, gain, gain_unity, gain_max, frame_lines, frame_lines_min, frame_lines_max, margin;
+	uint32_t sensor, focus, reserved[5];
+};
+struct nc_cam_cmd {
+	uint32_t command, bytes, a, b, c, d;
+};
+_Static_assert(sizeof(struct nc_cam_frame) == 120, "camera userspace frame ABI");
+int herolte_rcam_dev_start(void);
+void herolte_rcam_dev_stop(void);
+int herolte_rcam_dev_read(struct uio *);
+int herolte_rcam_dev_exposure(uint32_t, uint32_t);
+#endif
