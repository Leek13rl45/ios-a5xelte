+/* Same mode 3 wire protocol without the 2 us half periods, for the patch
+ * download (Linux drives this bus at up to 26 MHz). The DAT value is read
+ * once; only CLK/MOSI/CS change while the bank is owned by this probe. */
+static void
+gps_transfer_fast(vm_offset_t spi, uint8_t *bytes, unsigned count)
+{
+	volatile uint32_t *dat = (volatile uint32_t *)spi;
+	uint32_t base = gps_read(spi) & ~(CLK | MOSI | CS);
+	*dat = base | CLK;
+	__asm__ volatile ("dsb osh" ::: "memory");
+	delay(1);
+	for (unsigned i = 0; i < count; i++) {
+		uint8_t tx = bytes[i], rx = 0;
+		for (unsigned bit = 0; bit < 8; bit++) {
+			uint32_t mosi = (tx & 0x80) ? MOSI : 0;
+			*dat = base | mosi;
+			__asm__ volatile ("dsb osh" ::: "memory");
+			*dat = base | mosi | CLK;
+			__asm__ volatile ("dsb osh" ::: "memory");
+			rx = (uint8_t)((rx << 1) | !!(gps_read(spi) & MISO));
+			tx = (uint8_t)(tx << 1);
+		}
+		bytes[i] = rx;
+	}
+	*dat = base | CLK | CS;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
