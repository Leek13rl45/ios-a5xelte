diff --git a/bsd/dev/herolte_linux.c b/bsd/dev/herolte_linux.c
--- a/bsd/dev/herolte_linux.c
+++ b/bsd/dev/herolte_linux.c
@@ -710,6 +710,23 @@
  * Partial-page protection changes widen to RWX and PROT_NONE is ignored.
  */
 #define LX_RWX (PROT_READ | PROT_WRITE | PROT_EXEC)
+
+/*
+ * vm_map_protect() strips exec from write+exec requests on iOS. Linux ELF
+ * code and data share 16K map pages, so the loader process (named linuxrun,
+ * which stays its name after linux_enter) may hold RWX pages.
+ */
+bool herolte_linux_allow_wx(void);
+bool
+herolte_linux_allow_wx(void)
+{
+	proc_t p = current_proc();
+	if (lx_enabled < 0) {
+		int enabled = 0;
+		lx_enabled = PE_parse_boot_argn("linuxabi", &enabled, sizeof(enabled)) && enabled == 1;
+	}
+	return lx_enabled && p != NULL && strncmp(p->p_comm, "linuxrun", sizeof(p->p_comm)) == 0;
+}
 
