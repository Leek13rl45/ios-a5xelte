+static void
+lx_log_exec(user_addr_t upath, user_addr_t uargv)
+{
+	char *buf;
+	size_t len = 0;
+	if (OSDecrementAtomic(&lx_unimpl_budget) <= 0) {
+		return;
+	}
+	buf = kalloc_data(MAXPATHLEN, Z_WAITOK);
+	if (buf == NULL) {
+		return;
+	}
+	if (copyinstr(upath, buf, MAXPATHLEN, &len)) {
+		strlcpy(buf, "?", MAXPATHLEN);
+	}
+	LXLOG("execve %s unsupported", buf);
+	for (int i = 0; i < 6 && uargv; i++) {
+		uint64_t ua;
+		if (copyin(uargv + 8 * (uint64_t)i, &ua, sizeof(ua)) || !ua ||
+		    copyinstr(ua, buf, 256, &len)) {
+			break;
+		}
+		LXLOG("  argv[%d] %s", i, buf);
+	}
+	kfree_data(buf, MAXPATHLEN);
+}
