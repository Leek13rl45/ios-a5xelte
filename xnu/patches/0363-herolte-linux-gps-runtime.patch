+/* --- directories, polling, misc -------------------------------------------------- */
+
+/*
+ * getdents64: Darwin getdirentries64 writes struct direntry records into the
+ * caller's buffer (and advances the fd offset); they are read back and
+ * rewritten in place as linux_dirent64 records, which are never longer.
+ * direntry: ino@0 u64, seekoff@8 u64, reclen@16 u16, namlen@18 u16, type@20,
+ * name@21. linux_dirent64: ino@0, off@8, reclen@16 u16, type@18, name@19.
+ */
+static int64_t
+lx_getdents64(int fd, user_addr_t ub, uint64_t count)
+{
+	ssize_t n = 0;
+	size_t in = 0, out = 0;
+	uint8_t *buf;
+	int error;
+
+	count = MIN(count, (uint64_t)65536);
+	error = herolte_linux_getdirentries64(fd, ub, (user_size_t)count, &n);
+	if (error) {
+		return -lx_errno(error);
+	}
+	if (n <= 0) {
+		return 0;
+	}
+	buf = kalloc_data((vm_size_t)n, Z_WAITOK);
+	if (buf == NULL) {
+		return -LX_ENOMEM;
+	}
+	if (copyin(ub, buf, (size_t)n)) {
+		kfree_data(buf, (vm_size_t)n);
+		return -LX_EFAULT;
+	}
+	while (in + 21 <= (size_t)n) {
+		uint64_t ino, off;
+		uint16_t drec, nlen, lrec;
+		uint8_t type;
+		memcpy(&ino, buf + in, 8);
+		memcpy(&off, buf + in + 8, 8);
+		memcpy(&drec, buf + in + 16, 2);
+		memcpy(&nlen, buf + in + 18, 2);
+		type = buf[in + 20];
+		if (drec < 22 || in + drec > (size_t)n || (size_t)nlen + 22 > drec) {
+			break;
+		}
+		lrec = (uint16_t)((19 + nlen + 1 + 7) & ~7);
+		memmove(buf + out + 19, buf + in + 21, nlen);
+		memcpy(buf + out, &ino, 8);
+		memcpy(buf + out + 8, &off, 8);
+		memcpy(buf + out + 16, &lrec, 2);
+		buf[out + 18] = type;
+		bzero(buf + out + 19 + nlen, (size_t)lrec - 19 - nlen);
+		out += lrec;
+		in += drec;
+	}
+	error = copyout(buf, ub, out);
+	kfree_data(buf, (vm_size_t)n);
+	return error ? -LX_EFAULT : (int64_t)out;
+}
