+/* mkfifo1() with a kernel path. */
+int
+herolte_linux_mkfifoat(vfs_context_t ctx, int fd, const char *kpath, int mode)
+{
+	struct vnode_attr va;
+	struct nameidata nd;
+	vnode_t vp, dvp;
+	int error;
+
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, (mode & ALLPERMS) & ~vfs_context_proc(ctx)->p_fd.fd_cmask);
+	NDINIT(&nd, CREATE, OP_MKFIFO, LOCKPARENT | AUDITVNPATH1,
+	    UIO_SYSSPACE, CAST_USER_ADDR_T(kpath), ctx);
+	error = nameiat(&nd, fd);
+	if (error) {
+		return error;
+	}
+	dvp = nd.ni_dvp;
+	vp = nd.ni_vp;
+	if (vp != NULL) {
+		error = EEXIST;
+		goto out;
+	}
+	VATTR_SET(&va, va_type, VFIFO);
+	if ((error = vn_authorize_create(dvp, &nd.ni_cnd, &va, ctx, NULL)) != 0) {
+		goto out;
+	}
+	error = vn_create(dvp, &vp, &nd, &va, 0, 0, NULL, ctx);
+out:
+	nameidone(&nd);
+	if (vp) {
+		vnode_put(vp);
+	}
+	vnode_put(dvp);
+	return error;
 }
+
+int
+herolte_linux_fchmodat(vfs_context_t ctx, int fd, const char *kpath, int mode)
+{
+	return fchmodat_internal(ctx, CAST_USER_ADDR_T(kpath), mode, fd, 0, UIO_SYSSPACE);
+}
+
+int
+herolte_linux_chdir(vfs_context_t ctx, const char *kpath)
+{
+	struct nameidata nd;
+
+	NDINIT(&nd, LOOKUP, OP_CHDIR, FOLLOW | AUDITVNPATH1,
+	    UIO_SYSSPACE, CAST_USER_ADDR_T(kpath), ctx);
+	return chdir_internal(vfs_context_proc(ctx), ctx, &nd, 0);
+}
