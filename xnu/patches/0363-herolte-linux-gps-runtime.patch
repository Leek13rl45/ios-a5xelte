+/* Rewrite a Linux path (kernel string) into out[size]: device table, then
+ * relative and iOS paths unchanged, then everything else under LX_ROOT. */
+static int
+lx_rewrite(const char *in, char *out, size_t size)
+{
+	for (unsigned i = 0; i < sizeof(lx_devmap) / sizeof(lx_devmap[0]); i++) {
+		if (!strcmp(in, lx_devmap[i].lx)) {
+			return strlcpy(out, lx_devmap[i].ios, size) >= size ? ENAMETOOLONG : 0;
+		}
+	}
+	if (in[0] != '/' || lx_passthrough(in)) {
+		return strlcpy(out, in, size) >= size ? ENAMETOOLONG : 0;
+	}
+	if (strlen(LX_ROOT) + strlen(in) >= size) {
+		return ENAMETOOLONG;
+	}
+	strlcpy(out, LX_ROOT, size);
+	strlcat(out, in, size);
+	return 0;
+}
