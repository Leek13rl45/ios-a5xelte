+struct lx_sysinfo {
+	int64_t  uptime;
+	uint64_t loads[3];
+	uint64_t totalram, freeram, sharedram, bufferram, totalswap, freeswap;
+	uint16_t procs, pad;
+	uint32_t pad2;
+	uint64_t totalhigh, freehigh;
+	uint32_t mem_unit;
+	uint32_t pad3;
+};
+_Static_assert(sizeof(struct lx_sysinfo) == 112, "Linux arm64 struct sysinfo");
+
+static int64_t
+lx_sysinfo(user_addr_t ub)
+{
+	struct lx_sysinfo si = {};
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_continuous_time(), &ns);
+	si.uptime = (int64_t)(ns / NSEC_PER_SEC);
+	si.totalram = max_mem;
+	si.freeram = max_mem / 2;                       /* approximation */
+	si.procs = 1;
+	si.mem_unit = 1;
+	return copyout(&si, ub, sizeof(si)) ? -LX_EFAULT : 0;
+}
