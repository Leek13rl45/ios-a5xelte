+/* Exact Linux paths served by iOS device nodes (bsd/dev/herolte_gps.c). */
+static const struct {
+	const char *lx;
+	const char *ios;
+} lx_devmap[] = {
+	{ "/dev/ttyBCM", "/dev/herobcm0" },
+	{ "/dev/bbd_sensor", "/dev/herobcm1" },
+	{ "/sys/class/sec/gps/GPS_PWR_EN/value", "/dev/herobcm2" },
+};
