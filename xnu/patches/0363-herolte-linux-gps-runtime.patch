+/* --- shared helpers for the calls below ------------------------------------ */
+
+#define LX_ENAMETOOLONG  36
+#define LX_ENOPROTOOPT   92
+#define LX_EAFNOSUPPORT  97
+#define LX_ECONNREFUSED  111
+
+#define LXLOG_ONCE(fmt, ...) do {                                       \
+	static volatile UInt32 lx_once_;                                \
+	if (OSCompareAndSwap(0, 1, &lx_once_)) {                        \
+	        LXLOG(fmt, ##__VA_ARGS__);                              \
+	}                                                               \
+} while (0)
