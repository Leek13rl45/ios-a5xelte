+ *   /dev/herobcm1  /dev/bbd_sensor  never has data (no sensor hub packets)
+ *   /dev/herobcm2  GPS_PWR_EN value: "1"/"0" power the chip and own the pins
+ * One kernel thread polls HOST_REQ and drains the write queue over GPIO SSI.
+ */
+#define HB_RX_SIZE 65536
+#define HB_TX_SIZE 16384
+
+static struct {
+	vm_offset_t map[5];
+	struct gps_pins power, req, resp, spi, host;
+	struct gps_bus bus;
+	bool mapped, powered, stop, running;
+	lck_mtx_t *lock;
+	uint8_t rx[HB_RX_SIZE];
+	unsigned rx_head, rx_tail, rx_dropped;
+	uint8_t tx[HB_TX_SIZE];
+	unsigned tx_len;
+	struct selinfo rsel;
+	uint64_t frames, rx_bytes, tx_bytes;
+} hb;
+static LCK_GRP_DECLARE(hb_lck_grp, "herolte_gps");
+static LCK_MTX_DECLARE(hb_mtx, &hb_lck_grp);
+
+static unsigned
+hb_rx_count(void)
+{
+	return (hb.rx_head - hb.rx_tail) % HB_RX_SIZE;
+}
+
+static void
+hb_rx_push(const uint8_t *data, unsigned len)
+{
+	lck_mtx_lock(&hb_mtx);
+	for (unsigned i = 0; i < len; i++) {
+		if (hb_rx_count() == HB_RX_SIZE - 1) {
+			hb.rx_dropped += len - i;
+			break;
+		}
+		hb.rx[hb.rx_head] = data[i];
+		hb.rx_head = (hb.rx_head + 1) % HB_RX_SIZE;
+	}
+	hb.rx_bytes += len;
+	lck_mtx_unlock(&hb_mtx);
+	selwakeup(&hb.rsel);
+	wakeup(&hb.rx);
+}
+
+/* One SSI read when HOST_REQ is up; false if the chip did not answer. */
+static bool
+hb_receive(void)
+{
+	uint8_t frame[2 + 254];
+	unsigned len;
+	if (!gps_wake(&hb.bus)) {
+		return false;
+	}
+	frame[0] = 0x20;
+	frame[1] = 0;
+	gps_transfer_fast(hb.bus.spi, frame, 2);
+	if (frame[0] != 0) {
+		gps_set(hb.bus.req, 1U << 4, 0);
+		return false;
+	}
+	len = frame[1] ? frame[1] : 254;
+	memset(frame, 0, sizeof(frame));
+	frame[0] = 0x20;
+	gps_transfer_fast(hb.bus.spi, frame, len + 2);
+	gps_set(hb.bus.req, 1U << 4, 0);
+	if (frame[0] != 0) {
+		return false;
+	}
+	if (frame[1] < len) {
+		len = frame[1];
+	}
+	hb.frames++;
+	hb_rx_push(frame + 2, len);
+	return true;
+}
+
+static void
+hb_send_pending(void)
+{
+	static uint8_t out[1 + 1024];
+	unsigned n;
+	lck_mtx_lock(&hb_mtx);
+	n = MIN(hb.tx_len, (unsigned)sizeof(out) - 1);
+	memcpy(out + 1, hb.tx, n);
+	memmove(hb.tx, hb.tx + n, hb.tx_len - n);
+	hb.tx_len -= n;
+	lck_mtx_unlock(&hb_mtx);
+	wakeup(&hb.tx_len);
+	if (!n) {
+		return;
+	}
+	out[0] = 0;                     /* SSI half-duplex write */
+	if (gps_wake(&hb.bus)) {
+		gps_transfer_fast(hb.bus.spi, out, n + 1);
+		gps_set(hb.bus.req, 1U << 4, 0);
+		hb.tx_bytes += n;
+	}
+}
+
+static void
+hb_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	unsigned errors = 0;
+	printf("HEROLTE GPS: transport thread up\n");
+	while (!hb.stop) {
+		bool busy = false;
+		if (gps_read(hb.bus.host) & (1U << 4)) {
+			if (!hb_receive() && ++errors < 8) {
+				printf("HEROLTE GPS: SSI read failed\n");
+			}
+			busy = true;
+		}
+		if (hb.tx_len) {
+			hb_send_pending();
+			busy = true;
+		}
+		if (!busy) {
+			assert_wait_timeout(&hb.tx, THREAD_UNINT, 1, 1000 * NSEC_PER_USEC);
+			thread_block(THREAD_CONTINUE_NULL);
+		}
+	}
+	printf("HEROLTE GPS: transport thread down (frames %llu rx %llu tx %llu dropped %u)\n",
+	    hb.frames, hb.rx_bytes, hb.tx_bytes, hb.rx_dropped);
+	hb.running = false;
+	wakeup(&hb.running);
+}
+
+static void
+hb_power(bool on)
+{
+	if (on == hb.powered || !hb.mapped) {
+		return;
+	}
+	if (on) {
+		gps_configure(&hb.host, 0, 0, 0x100);
+		gps_configure(&hb.resp, 0, 0, 0x30);
+		gps_configure(&hb.req, 0x10000, 0, 0);
+		gps_configure(&hb.spi, 0x10110000, CS | CLK, 0xdf00);
+		gps_configure(&hb.power, 0x10, 0, 0);
+		delay(21000);
+		gps_set(hb.power.bank + DAT, 2, 2);
+		delay(31000);
+		lck_mtx_lock(&hb_mtx);
+		hb.rx_head = hb.rx_tail = 0;
+		hb.tx_len = 0;
+		lck_mtx_unlock(&hb_mtx);
+		hb.stop = false;
+		hb.running = true;
+		hb.powered = true;
+		thread_t th;
+		if (kernel_thread_start(hb_thread, NULL, &th) == KERN_SUCCESS) {
+			thread_deallocate(th);
+		} else {
+			hb.running = false;
+		}
+		printf("HEROLTE GPS: power on, req/resp/host=%d/%d/%d\n", !!(gps_read(hb.bus.req) & 16),
+		    !!(gps_read(hb.bus.resp) & 4), !!(gps_read(hb.bus.host) & 16));
+	} else {
+		hb.stop = true;
+		wakeup(&hb.tx);
+		while (hb.running) {
+			tsleep(&hb.running, PWAIT, "hbstop", hz / 10);
+		}
+		gps_set(hb.power.bank + DAT, 2, 0);
+		gps_restore(&hb.power);
+		gps_restore(&hb.spi);
+		gps_restore(&hb.req);
+		gps_restore(&hb.resp);
+		gps_restore(&hb.host);
+		hb.powered = false;
+		printf("HEROLTE GPS: power off\n");
+	}
 }
 
+static int
+hb_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+hb_read(dev_t dev, struct uio *uio, int ioflag)
+{
+	int error = 0;
+	if (minor(dev) == 2) {
+		char v[2] = { hb.powered ? '1' : '0', '\n' };
+		if (uio_offset(uio) >= 2) {
+			return 0;
+		}
+		return uiomove(v + uio_offset(uio), 2 - (int)uio_offset(uio), uio);
+	}
+	if (minor(dev) == 1) {
+		return (ioflag & IO_NDELAY) ? EWOULDBLOCK : tsleep(&hb.rsel, PCATCH | PWAIT, "bbdsens", 0);
+	}
+	lck_mtx_lock(&hb_mtx);
+	while (hb_rx_count() == 0) {
+		if (ioflag & IO_NDELAY) {
+			lck_mtx_unlock(&hb_mtx);
+			return EWOULDBLOCK;
+		}
+		error = msleep(&hb.rx, &hb_mtx, PCATCH | PWAIT, "ttybcm", NULL);
+		if (error) {
+			lck_mtx_unlock(&hb_mtx);
+			return error;
+		}
+	}
+	while (hb_rx_count() && uio_resid(uio) > 0 && !error) {
+		unsigned chunk = hb.rx_head >= hb.rx_tail ? hb.rx_head - hb.rx_tail : HB_RX_SIZE - hb.rx_tail;
+		chunk = MIN(chunk, (unsigned)uio_resid(uio));
+		error = uiomove((char *)hb.rx + hb.rx_tail, (int)chunk, uio);
+		hb.rx_tail = (hb.rx_tail + chunk) % HB_RX_SIZE;
+	}
+	lck_mtx_unlock(&hb_mtx);
+	return error;
+}
+
+static int
+hb_write(dev_t dev, struct uio *uio, int ioflag)
+{
+	int error = 0;
+	if (minor(dev) == 2) {
+		char c = 0;
+		if (uio_resid(uio) > 0) {
+			error = uiomove(&c, 1, uio);
+		}
+		uio_setresid(uio, 0);
+		if (!error && (c == '0' || c == '1')) {
+			hb_power(c == '1');
+		}
+		return error;
+	}
+	if (minor(dev) != 0) {
+		uio_setresid(uio, 0);
+		return 0;
+	}
+	if (!hb.powered) {
+		return EIO;
+	}
+	lck_mtx_lock(&hb_mtx);
+	while (uio_resid(uio) > 0 && !error) {
+		unsigned room = HB_TX_SIZE - hb.tx_len;
+		if (!room) {
+			if (ioflag & IO_NDELAY) {
+				error = EWOULDBLOCK;
+				break;
+			}
+			error = msleep(&hb.tx_len, &hb_mtx, PCATCH | PWAIT, "ttybcmw", NULL);
+			continue;
+		}
+		unsigned n = MIN(room, (unsigned)uio_resid(uio));
+		error = uiomove((char *)hb.tx + hb.tx_len, (int)n, uio);
+		if (!error) {
+			hb.tx_len += n;
+		}
+	}
+	lck_mtx_unlock(&hb_mtx);
+	wakeup(&hb.tx);
+	return error;
+}
+
+static int
+hb_select(dev_t dev, int which, void *wql, struct proc *p)
+{
+	if (which == FWRITE) {
+		return 1;
+	}
+	if (which == FREAD && minor(dev) == 0) {
+		int ready;
+		lck_mtx_lock(&hb_mtx);
+		ready = hb_rx_count() != 0;
+		if (!ready) {
+			selrecord(p, &hb.rsel, wql);
+		}
+		lck_mtx_unlock(&hb_mtx);
+		return ready;
+	}
+	if (which == FREAD && minor(dev) == 2) {
+		return 1;
+	}
+	return 0;
+}
+
+static int
+hb_ioctl(__unused dev_t dev, __unused u_long cmd, __unused caddr_t data, __unused int flag, __unused struct proc *p)
+{
+	return ENOTTY;
+}
+
+static const struct cdevsw hb_cdevsw = {
+	.d_open = hb_open, .d_close = hb_open, .d_read = hb_read, .d_write = hb_write,
+	.d_ioctl = hb_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = hb_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+static void
+hb_init(void)
+{
+	static const unsigned phys[] = {0x13610000, 0x14c80000, 0x136d0000, 0x14cc0000, 0x10580000};
+	int major;
+	for (unsigned i = 0; i < 5; i++) {
+		hb.map[i] = ml_io_map_unmappable(phys[i], 0x1000, VM_WIMG_IO);
+		if (!hb.map[i]) {
+			printf("HEROLTE GPS: MMIO map failed at %#x\n", phys[i]);
+			return;
+		}
+	}
+	gps_set(hb.map[0] + 0x800, 1U << 5, 1U << 5);
+	gps_set(hb.map[1] + 0x800, 1U << 8, 1U << 8);
+	if (!(gps_read(hb.map[0] + 0x800) & (1U << 5)) || !(gps_read(hb.map[1] + 0x800) & (1U << 8))) {
+		printf("HEROLTE GPS: GPIO bus clock disabled\n");
+		return;
+	}
+	hb.power = (struct gps_pins){ .bank = hb.map[2] + 0xa0, .con_mask = 0xf0, .dat_mask = 2, .pud_mask = 0xc };
+	hb.req = (struct gps_pins){ .bank = hb.map[3] + 0x40, .con_mask = 0xf0000, .dat_mask = 16, .pud_mask = 0x300 };
+	hb.resp = (struct gps_pins){ .bank = hb.map[3] + 0x140, .con_mask = 0xf00, .pud_mask = 0x30 };
+	hb.spi = (struct gps_pins){ .bank = hb.map[3] + 0xa0, .con_mask = 0xffff0000, .dat_mask = CLK | CS | MOSI, .pud_mask = 0xff00 };
+	hb.host = (struct gps_pins){ .bank = hb.map[4] + 0x60, .con_mask = 0xf0000, .pud_mask = 0x300 };
+	hb.bus = (struct gps_bus){ hb.spi.bank + DAT, hb.req.bank + DAT, hb.resp.bank + DAT, hb.host.bank + DAT };
+	hb.mapped = true;
+	major = cdevsw_add(-1, &hb_cdevsw);
+	for (int m = 0; major >= 0 && m < 3; m++) {
+		if (!devfs_make_node(makedev(major, m), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "herobcm%d", m)) {
+			major = -1;
+		}
+	}
+	printf("HEROLTE GPS: runtime transport %s (/dev/herobcm0-2)\n", major >= 0 ? "ready" : "FAILED");
+}
