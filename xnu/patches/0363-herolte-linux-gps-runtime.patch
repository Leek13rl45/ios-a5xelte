+/* Darwin errno -> -Linux errno; blocking socket calls may return ERESTART. */
+static int64_t
+lx_err(int e)
+{
+	return -lx_errno(e == ERESTART ? EINTR : e);
+}
+
+static void
+lx_set_nonblock(proc_t p, int fd, bool on)
+{
+	int64_t fl = lx_fcntl(p, fd, 3, 0);
+	if (fl >= 0) {
+		(void)lx_fcntl(p, fd, 4, on ? ((uint64_t)fl | 0x800) : ((uint64_t)fl & ~(uint64_t)0x800));
+	}
+}
+
+/* SOCK_NONBLOCK / SOCK_CLOEXEC (= O_NONBLOCK / O_CLOEXEC) on a new fd. */
+#define LX_SOCK_NONBLOCK 0x800
+#define LX_SOCK_CLOEXEC  0x80000
+
+static void
+lx_fd_flags(proc_t p, int fd, uint64_t lflags)
+{
+	if (lflags & LX_SOCK_CLOEXEC) {
+		(void)lx_fcntl(p, fd, 2, 1);
+	}
+	if (lflags & LX_SOCK_NONBLOCK) {
+		lx_set_nonblock(p, fd, true);
+	}
+}
+
+/* --- sockets ----------------------------------------------------------------- */
+
+/*
+ * Socket addresses: Linux sockaddr starts with a 16-bit family, Darwin with
+ * (len, family); the rest of sockaddr_un/_in/_in6 is laid out identically.
+ * Input addresses (bind, connect, sendto) are translated into a kernel
+ * sockaddr_storage and handed to the socket layer directly: the sock_bind()
+ * and sock_connect() KPIs, and pru_sosend() for sendto (as sock_send_internal
+ * does, but with the data left in user space). Output addresses come from
+ * sock_get{sock,peer}name() into a kernel buffer (getsockname, getpeername,
+ * accept) or from Darwin recvfrom() into the caller's buffer, and are
+ * rewritten into Linux layout. AF_UNIX paths go through lx_rewrite() on the
+ * way in and lose the LX_ROOT prefix on the way out; abstract names are not
+ * supported. Every socket gets SO_NOSIGPIPE: Linux signals are not delivered,
+ * so a SIGPIPE on EPIPE would kill the process instead of returning -EPIPE.
+ */
+#define LX_AF_UNIX  1
+#define LX_AF_INET  2
+#define LX_AF_INET6 10
+
+static void
+lx_sock_setup(int fd)
+{
+	socket_t so;
+	int one = 1;
+	if (file_socket(fd, &so) == 0) {
+		(void)sock_setsockopt(so, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof(one));
+		file_drop(fd);
+	}
 }
 
+/* Linux sockaddr (user) -> Darwin sockaddr (kernel). 0 or -Linux errno. */
+static int64_t
+lx_sockaddr_in(user_addr_t ua, uint64_t ulen, struct sockaddr_storage *ss, int64_t abstract_err)
+{
+	uint8_t lb[128] = {};
+	uint16_t fam;
+
+	bzero(ss, sizeof(*ss));
+	if (ulen < 2 || ulen > sizeof(lb)) {
+		return -LX_EINVAL;
+	}
+	if (copyin(ua, lb, (size_t)ulen)) {
+		return -LX_EFAULT;
+	}
+	memcpy(&fam, lb, sizeof(fam));
+	switch (fam) {
+	case LX_AF_UNIX: {
+		struct sockaddr_un *sun = (struct sockaddr_un *)ss;
+		char path[109];
+		size_t n = MIN((size_t)ulen - 2, sizeof(path) - 1);
+		memcpy(path, lb + 2, n);
+		path[n] = 0;
+		if (path[0] == 0) {
+			return abstract_err;            /* unnamed or abstract */
+		}
+		if (lx_rewrite(path, sun->sun_path, sizeof(sun->sun_path))) {
+			return -LX_ENAMETOOLONG;
+		}
+		sun->sun_family = AF_UNIX;
+		sun->sun_len = (uint8_t)(offsetof(struct sockaddr_un, sun_path) + strlen(sun->sun_path) + 1);
+		return 0;
+	}
+	case LX_AF_INET:
+		if (ulen < sizeof(struct sockaddr_in)) {
+			return -LX_EINVAL;
+		}
+		memcpy((uint8_t *)ss + 2, lb + 2, sizeof(struct sockaddr_in) - 2);
+		ss->ss_len = sizeof(struct sockaddr_in);
+		ss->ss_family = AF_INET;
+		return 0;
+	case LX_AF_INET6:
+		if (ulen < 24) {                        /* SIN6_LEN_RFC2133 */
+			return -LX_EINVAL;
+		}
+		memcpy((uint8_t *)ss + 2, lb + 2, MIN((size_t)ulen, sizeof(struct sockaddr_in6)) - 2);
+		ss->ss_len = sizeof(struct sockaddr_in6);
+		ss->ss_family = AF_INET6;
+		return 0;
+	default:
+		return -LX_EAFNOSUPPORT;
+	}
+}
+
+/* Darwin sockaddr (kernel, dlen bytes) -> Linux sockaddr at ua (cap bytes),
+ * length at ulenp. */
+static int64_t
+lx_sockaddr_out(const uint8_t *da, size_t dlen, user_addr_t ua, user_addr_t ulenp, uint32_t cap)
+{
+	uint8_t lb[132] = {};
+	uint16_t fam = 0;
+	uint32_t llen = 2;
+
+	if (dlen >= 1 && da[0] >= 2) {
+		dlen = MIN(dlen, (size_t)da[0]);
+	}
+	dlen = MIN(dlen, (size_t)128);
+	if (dlen >= 2) {
+		switch (da[1]) {
+		case AF_UNIX: {
+			const char *path = (const char *)da + 2;
+			size_t n = strnlen(path, dlen - 2), skip = 0, rl = strlen(LX_ROOT);
+			if (n > rl && !strncmp(path, LX_ROOT, rl) && path[rl] == '/') {
+				skip = rl;
+			}
+			memcpy(lb + 2, path + skip, n - skip);
+			fam = LX_AF_UNIX;
+			llen = n ? (uint32_t)(2 + (n - skip) + 1) : 2;
+			break;
+		}
+		case AF_INET:
+			fam = LX_AF_INET;
+			llen = sizeof(struct sockaddr_in);
+			memcpy(lb + 2, da + 2, MIN(dlen, (size_t)llen) - 2);
+			break;
+		case AF_INET6:
+			fam = LX_AF_INET6;
+			llen = sizeof(struct sockaddr_in6);
+			memcpy(lb + 2, da + 2, MIN(dlen, (size_t)llen) - 2);
+			break;
+		default:
+			fam = da[1];
+			llen = (uint32_t)dlen;
+			memcpy(lb + 2, da + 2, dlen - 2);
+			break;
+		}
+	}
+	memcpy(lb, &fam, sizeof(fam));
+	if (copyout(lb, ua, MIN(cap, llen)) || copyout(&llen, ulenp, sizeof(llen))) {
+		return -LX_EFAULT;
+	}
+	return 0;
+}
+
+static int64_t
+lx_sockname(int fd, bool peer, user_addr_t ua, user_addr_t ulenp)
+{
+	struct sockaddr_storage ss = {};
+	socket_t so;
+	uint32_t cap;
+	int error;
+
+	if (!ua || !ulenp) {
+		return -LX_EFAULT;
+	}
+	if (copyin(ulenp, &cap, sizeof(cap))) {
+		return -LX_EFAULT;
+	}
+	if ((error = file_socket(fd, &so)) != 0) {
+		return -lx_errno(error);
+	}
+	error = peer ? sock_getpeername(so, (struct sockaddr *)&ss, sizeof(ss)) :
+	    sock_getsockname(so, (struct sockaddr *)&ss, sizeof(ss));
+	file_drop(fd);
+	if (error) {
+		return -lx_errno(error);
+	}
+	return lx_sockaddr_out((const uint8_t *)&ss, sizeof(ss), ua, ulenp, cap);
+}
+
+static int64_t
+lx_socket(proc_t p, uint64_t domain, uint64_t ltype, uint64_t proto)
+{
+	struct socket_args sa = { .type = (int)(ltype & 0xf), .protocol = (int)proto };
+	int32_t fd = -1;
+	int error;
+
+	switch (domain) {
+	case LX_AF_UNIX: sa.domain = AF_UNIX; break;
+	case LX_AF_INET: sa.domain = AF_INET; break;
+	case LX_AF_INET6: sa.domain = AF_INET6; break;
+	default:
+		if (OSDecrementAtomic(&lx_unimpl_budget) > 0) {
+			LXLOG("socket domain %llu type %#llx unsupported", domain, ltype);
+		}
+		return -LX_EAFNOSUPPORT;
+	}
+	error = socket(p, &sa, &fd);
+	if (error) {
+		return lx_err(error);
+	}
+	lx_sock_setup(fd);
+	lx_fd_flags(p, fd, ltype);
+	return fd;
+}
+
+static int64_t
+lx_socketpair(proc_t p, uint64_t domain, uint64_t ltype, uint64_t proto, user_addr_t usv)
+{
+	struct socketpair_args sa = {
+		.domain = AF_UNIX, .type = (int)(ltype & 0xf), .protocol = (int)proto, .rsv = usv,
+	};
+	int32_t sv[2], rv = 0;
+	int error;
+
+	if (domain != LX_AF_UNIX) {
+		return -LX_EAFNOSUPPORT;
+	}
+	error = socketpair(p, &sa, &rv);     /* copies the two fds out to usv */
+	if (error) {
+		return lx_err(error);
+	}
+	if (copyin(usv, sv, sizeof(sv))) {
+		return -LX_EFAULT;
+	}
+	for (int i = 0; i < 2; i++) {
+		lx_sock_setup(sv[i]);
+		lx_fd_flags(p, sv[i], ltype);
+	}
+	return 0;
+}
+
+static int64_t
+lx_bind_connect(int fd, user_addr_t ua, uint64_t ulen, bool conn)
+{
+	struct sockaddr_storage ss;
+	socket_t so;
+	int error;
+	int64_t r = lx_sockaddr_in(ua, ulen, &ss, conn ? -LX_ECONNREFUSED : -LX_ENOENT);
+
+	if (r) {
+		if (lx_trace) {
+			LXLOG("%s fd %d: Linux address rejected (%lld)", conn ? "connect" : "bind", fd, r);
+		}
+		return r;
+	}
+	if ((error = file_socket(fd, &so)) != 0) {
+		return -lx_errno(error);
+	}
+	error = conn ? sock_connect(so, (struct sockaddr *)&ss, 0) : sock_bind(so, (struct sockaddr *)&ss);
+	file_drop(fd);
+	if (lx_trace && ss.ss_family == AF_UNIX) {
+		LXLOG("%s fd %d %s = %d", conn ? "connect" : "bind", fd,
+		    ((struct sockaddr_un *)&ss)->sun_path, error);
+	}
+	return error ? lx_err(error) : 0;
+}
+
+static int64_t
+lx_accept(proc_t p, int fd, user_addr_t ua, user_addr_t ulenp, uint64_t flags)
+{
+	struct accept_args aa = { .s = fd, .name = USER_ADDR_NULL, .anamelen = USER_ADDR_NULL };
+	int32_t nfd = -1;
+	int error = accept(p, &aa, &nfd);
+
+	if (error) {
+		return lx_err(error);
+	}
+	lx_sock_setup(nfd);
+	/* Darwin inherits O_NONBLOCK from the listener, Linux does not. */
+	lx_set_nonblock(p, nfd, (flags & LX_SOCK_NONBLOCK) != 0);
+	if (flags & LX_SOCK_CLOEXEC) {
+		(void)lx_fcntl(p, nfd, 2, 1);
+	}
+	if (ua && ulenp && lx_sockname(nfd, true, ua, ulenp) != 0) {
+		uint32_t zero = 0;                      /* peer gone: no address */
+		(void)copyout(&zero, ulenp, sizeof(zero));
+	}
+	return nfd;
+}
+
+/* Linux MSG_* -> Darwin MSG_*. MSG_NOSIGNAL: sockets have SO_NOSIGPIPE. */
+static int
+lx_msg_flags(uint64_t lf)
+{
+	int f = (int)(lf & 7);                          /* OOB, PEEK, DONTROUTE */
+	if (lf & 0x20) {
+		f |= MSG_TRUNC;
+	}
+	if (lf & 0x40) {
+		f |= MSG_DONTWAIT;
+	}
+	if (lf & 0x80) {
+		f |= MSG_EOR;
+	}
+	if (lf & 0x100) {
+		f |= MSG_WAITALL;
+	}
+	return f;
+}
+
+static int64_t
+lx_sendto(proc_t p, int fd, user_addr_t buf, uint64_t len, uint64_t lflags, user_addr_t to, uint64_t tolen)
+{
+	struct sockaddr_storage ss;
+	socket_t so;
+	uio_t auio;
+	user_ssize_t sent;
+	int error, flags = lx_msg_flags(lflags);
+	int64_t r;
+
+	if (len > INT_MAX) {
+		return -LX_EINVAL;
+	}
+	if (!to) {
+		struct sendto_args sa = { .s = fd, .buf = buf, .len = len, .flags = flags };
+		int32_t rv = 0;
+		error = sendto(p, &sa, &rv);
+		return error ? lx_err(error) : rv;
+	}
+	if ((r = lx_sockaddr_in(to, tolen, &ss, -LX_ECONNREFUSED)) != 0) {
+		return r;
+	}
+	if ((error = file_socket(fd, &so)) != 0) {
+		return -lx_errno(error);
+	}
+	auio = uio_create(1, 0, UIO_USERSPACE64, UIO_WRITE);
+	if (auio == NULL) {
+		file_drop(fd);
+		return -LX_ENOMEM;
+	}
+	uio_addiov(auio, buf, (user_size_t)len);
+	error = so->so_proto->pr_usrreqs->pru_sosend(so, (struct sockaddr *)&ss, auio, NULL, NULL, flags);
+	sent = (user_ssize_t)len - uio_resid(auio);
+	if (sent && (error == ERESTART || error == EINTR || error == EWOULDBLOCK)) {
+		error = 0;
+	}
+	uio_free(auio);
+	file_drop(fd);
+	return error ? lx_err(error) : (int64_t)sent;
+}
+
+static int64_t
+lx_recvfrom(proc_t p, int fd, user_addr_t buf, uint64_t len, uint64_t lflags, user_addr_t from, user_addr_t fromlenp)
+{
+	struct recvfrom_args ra = { .s = fd, .buf = buf, .len = len, .flags = lx_msg_flags(lflags) };
+	uint32_t cap = 0, got = 0;
+	uint8_t da[128];
+	int32_t rv = 0;
+	int error;
+
+	if (from && fromlenp) {
+		if (copyin(fromlenp, &cap, sizeof(cap))) {
+			return -LX_EFAULT;
+		}
+		ra.from = from;                         /* Darwin layout lands here first */
+		ra.fromlenaddr = fromlenp;
+	}
+	error = recvfrom(p, &ra, &rv);
+	if (error) {
+		return lx_err(error);
+	}
+	if (ra.from) {
+		if (copyin(fromlenp, &got, sizeof(got))) {
+			return -LX_EFAULT;
+		}
+		got = MIN(got, (uint32_t)sizeof(da));
+		if (got >= 2 && copyin(from, da, got) == 0) {
+			(void)lx_sockaddr_out(da, got, from, fromlenp, cap);
+		}
+	}
+	return rv;
+}
+
+/* Linux (level, optname) -> Darwin. */
+static bool
+lx_sockopt(int llevel, int lname, int *level, int *name)
+{
+	static const int sol[][2] = {
+		{ 2, SO_REUSEADDR }, { 3, SO_TYPE }, { 4, SO_ERROR }, { 5, SO_DONTROUTE },
+		{ 6, SO_BROADCAST }, { 7, SO_SNDBUF }, { 8, SO_RCVBUF }, { 9, SO_KEEPALIVE },
+		{ 10, SO_OOBINLINE }, { 13, SO_LINGER_SEC }, { 15, SO_REUSEPORT },
+		{ 18, SO_RCVLOWAT }, { 19, SO_SNDLOWAT }, { 20, SO_RCVTIMEO }, { 21, SO_SNDTIMEO },
+	};
+	static const int tcp[][2] = {
+		{ 1, 0x1 /* TCP_NODELAY */ }, { 4, 0x10 /* TCP_KEEPALIVE */ },
+		{ 5, 0x101 /* TCP_KEEPINTVL */ }, { 6, 0x102 /* TCP_KEEPCNT */ },
+	};
+	const int (*tab)[2];
+	unsigned n;
+
+	if (llevel == 1) {
+		tab = sol;
+		n = sizeof(sol) / sizeof(sol[0]);
+		*level = SOL_SOCKET;
+	} else if (llevel == IPPROTO_TCP) {
+		tab = tcp;
+		n = sizeof(tcp) / sizeof(tcp[0]);
+		*level = IPPROTO_TCP;
+	} else {
+		return false;
+	}
+	for (unsigned i = 0; i < n; i++) {
+		if (tab[i][0] == lname) {
+			*name = tab[i][1];
+			return true;
+		}
+	}
+	return false;
+}
+
+static int64_t
+lx_setsockopt(proc_t p, int fd, int llevel, int lname, user_addr_t val, uint64_t vlen)
+{
+	struct setsockopt_args sa = { .s = fd, .val = val, .valsize = (socklen_t)vlen };
+	int32_t rv = 0;
+	int error;
+
+	if (llevel == 1 && lname == 16) {               /* SO_PASSCRED */
+		return 0;
+	}
+	if (!lx_sockopt(llevel, lname, &sa.level, &sa.name)) {
+		if (OSDecrementAtomic(&lx_unimpl_budget) > 0) {
+			LXLOG("setsockopt level %d name %d ignored", llevel, lname);
+		}
+		return 0;
+	}
+	/* Linux timeval {s64, s64} reads as Darwin user64_timeval {s64, s32, pad}. */
+	error = setsockopt(p, &sa, &rv);
+	return error ? lx_err(error) : 0;
+}
+
+static int64_t
+lx_peercred(int fd, user_addr_t val, user_addr_t ulenp)
+{
+	struct { int32_t pid; uint32_t uid; uint32_t gid; } cred = {
+		proc_pid(current_proc()), kauth_getuid(), kauth_getgid(),
+	};
+	uint32_t cap, n = sizeof(cred);
+	socket_t so;
+	int pid = 0, len = sizeof(pid);
+
+	if (copyin(ulenp, &cap, sizeof(cap))) {
+		return -LX_EFAULT;
+	}
+	if (file_socket(fd, &so) == 0) {
+		if (sock_getsockopt(so, SOL_LOCAL, LOCAL_PEERPID, &pid, &len) == 0 && pid > 0) {
+			cred.pid = pid;
+		}
+		file_drop(fd);
+	}
+	if (copyout(&cred, val, MIN(cap, n)) || copyout(&n, ulenp, sizeof(n))) {
