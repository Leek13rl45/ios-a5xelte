+static int64_t
+lx_getsockopt(proc_t p, int fd, int llevel, int lname, user_addr_t val, user_addr_t ulenp)
+{
+	struct getsockopt_args ga = { .s = fd, .val = val, .avalsize = ulenp };
+	int32_t rv = 0;
+	int error;
+
+	if (llevel == 1 && lname == 17) {               /* SO_PEERCRED */
+		return lx_peercred(fd, val, ulenp);
+	}
+	if (!lx_sockopt(llevel, lname, &ga.level, &ga.name)) {
+		if (OSDecrementAtomic(&lx_unimpl_budget) > 0) {
+			LXLOG("getsockopt level %d name %d unsupported", llevel, lname);
+		}
+		return -LX_ENOPROTOOPT;
+	}
+	error = getsockopt(p, &ga, &rv);
+	if (error) {
+		return lx_err(error);
+	}
+	if (ga.level == SOL_SOCKET && ga.name == SO_ERROR) {
+		int32_t e;
+		if (!copyin(val, &e, sizeof(e)) && e) {
+			e = lx_errno(e);
+			(void)copyout(&e, val, sizeof(e));
+		}
+	} else if (ga.level == SOL_SOCKET && (ga.name == SO_RCVTIMEO || ga.name == SO_SNDTIMEO)) {
+		uint8_t tv[16];
+		uint32_t n;
+		if (!copyin(ulenp, &n, sizeof(n)) && n >= sizeof(tv) && !copyin(val, tv, sizeof(tv))) {
+			int32_t us;
+			int64_t us64;
+			memcpy(&us, tv + 8, sizeof(us));
+			us64 = us;                      /* drop Darwin's padding word */
+			memcpy(tv + 8, &us64, sizeof(us64));
+			(void)copyout(tv, val, sizeof(tv));
+		}
+	}
+	return 0;
+}
